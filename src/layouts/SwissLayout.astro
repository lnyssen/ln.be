---
import { ClientRouter } from 'astro:transitions';
import '../styles/swiss.css';
import SwissCursor from '../components/SwissCursor.jsx';
import SwissGrid from '../components/SwissGrid.astro';
import SwissDock from '../components/SwissDock.astro';
import SwissJeux from '../components/SwissJeux.astro';
import SwissLab from '../components/SwissLab.astro';

interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
}

const {
  title = 'Laurent Nyssen — Multidisciplinary Designer',
  description = "I'm a Brussels-based designer creating bold identities and digital experiences through creative direction, strategy, branding and UX/UI with AI used where it truly adds value.",
  noindex = false,
} = Astro.props;

// Fiche structurée, posée sur la seule page d'accueil : c'est elle qui
// représente la personne, la répéter sur chaque page n'ajoute rien.
const person = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Laurent Nyssen',
  alternateName: 'LN',
  jobTitle: 'Multidisciplinary Designer',
  url: 'https://laurentnyssen.be',
  email: 'mailto:hello@laurentnyssen.be',
  telephone: '+32497305080',
  address: {
    '@type': 'PostalAddress',
    addressLocality: 'Brussels',
    addressCountry: 'BE',
  },
  knowsAbout: [
    'Brand strategy',
    'Creative direction',
    'Visual identity',
    'UX/UI design',
    'Editorial and print design',
    'Design systems',
  ],
  sameAs: [
    'https://www.linkedin.com/in/laurentnyssen/',
    'https://www.instagram.com/lepolographe/',
    'https://open.spotify.com/user/116697393',
  ],
};

// Adresses absolues : les réseaux sociaux refusent les chemins relatifs.
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ogImage = new URL('/og.png', Astro.site).href;
---

<html lang="en" class="swiss" data-swiss-theme="light">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <link rel="canonical" href={canonical} />
    {
      Astro.url.pathname === '/' && (
        <script type="application/ld+json" set:html={JSON.stringify(person)} />
      )
    }
    {noindex && <meta name="robots" content="noindex" />}

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Laurent Nyssen" />
    <meta property="og:locale" content="en_GB" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Laurent Nyssen — Multidisciplinary Designer" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <!-- Safari teinte ses barres avec cette valeur. Sans elle, il échantillonne
         le bas de la page — c'est-à-dire le violet du pied, qui débordait dans
         la barre d'adresse. Les deux déclarations couvrent le réglage du
         système ; le script ci-dessous les remplace par le thème réellement
         appliqué, que le visiteur l'ait choisi ou non. -->
    <meta name="theme-color" content="#f4f2ed" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#1d1f21" media="(prefers-color-scheme: dark)" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <!-- Un seul fichier porte toutes les graisses, demandé avant que le CSS
         ne le réclame. Sans cela le texte s'affiche d'abord dans la police de
         secours puis change de largeur. `crossorigin` est obligatoire, une
         police se charge en anonyme et le préchargement serait sinon perdu. -->
    <link rel="preload" as="font" type="font/woff2" href="/fonts/switzer-variable.woff2" crossorigin />
    <script is:inline>
      // Thème appliqué avant le premier paint pour éviter le flash. Une
      // transition de vue remplace le document et ses attributs : on repose
      // le thème avant que la nouvelle page ne s'affiche, sinon elle
      // apparaîtrait en clair le temps d'une image.
      (() => {
        // Safari en navigation privée refuse le stockage local et lève une
        // exception à la lecture. Sans garde, tout ce qui suit mourait avec
        // elle : ni thème, ni teinte, ni couleur de barre. On lit donc à
        // l'abri, quitte à retomber sur les réglages du système.
        const retenu = (cle) => {
          try {
            return localStorage.getItem(cle);
          } catch {
            return null;
          }
        };

        const apply = () => {
          const root = document.documentElement;
          const stored = retenu('swiss-theme');
          root.dataset.swissTheme =
            stored ?? (matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');

          // La teinte d'accent choisie par le visiteur, posée ici pour la
          // même raison que le thème : appliquée après coup, la page
          // paraîtrait violette le temps d'une image.
          const teinte = retenu('swiss-accent');
          if (teinte) root.dataset.swissAccent = teinte;
          else delete root.dataset.swissAccent;

          poserTeinte();

          // La barre du navigateur est teintée après le thème et la teinte,
          // pas avant : elle lit le papier réellement appliqué.
          poserBarre();

          // Le disque remplace la flèche : on la masque dès maintenant, aux
          // seules conditions où le disque existera.
          if (
            matchMedia('(pointer: fine)').matches &&
            !matchMedia('(prefers-reduced-motion: reduce)').matches
          ) {
            root.dataset.swissCursor = '';
          }
        };

        // La teinte d'accent vit. Sans choix du visiteur, elle suit l'heure
        // de Bruxelles : froide le matin, la violette de la marque vers midi,
        // chaude le soir. Un choix fait à la capsule, ou le mode encre,
        // l'emportent.
        //
        // La couleur se construit en OKLCH : à clarté égale, toutes les
        // teintes pèsent pareil et gardent le même contraste sur le papier —
        // 0,50 sur fond clair, 0,78 sur fond sombre. C'est la teinte qui
        // change, jamais la lisibilité.
        const PALIERS = [
          [0, 295], [5, 270], [8, 235], [12, 285],
          [16, 320], [19, 15], [21, 10], [23, 300], [24, 295],
        ];
        const teinteHeure = () => {
          let h = 12;
          try {
            const parts = new Intl.DateTimeFormat('en-GB', {
              timeZone: 'Europe/Brussels', hour: 'numeric', minute: 'numeric', hourCycle: 'h23',
            }).formatToParts(new Date());
            const val = (t) => Number(parts.find((p) => p.type === t)?.value || 0);
            h = val('hour') + val('minute') / 60;
          } catch {}
          for (let i = 0; i < PALIERS.length - 1; i++) {
            const [h0, t0] = PALIERS[i];
            const [h1, t1] = PALIERS[i + 1];
            if (h >= h0 && h <= h1) {
              // Le plus court chemin sur le cercle des teintes.
              let d = t1 - t0;
              if (d > 180) d -= 360;
              if (d < -180) d += 360;
              return (t0 + d * ((h - h0) / (h1 - h0)) + 360) % 360;
            }
          }
          return 285;
        };
        const poserTeinte = () => {
          const root = document.documentElement;
          if (root.dataset.swissAccent || root.classList.contains('ink-on')) {
            root.style.removeProperty('--accent');
            return;
          }
          const clarte = root.dataset.swissTheme === 'dark' ? 0.78 : 0.5;
          root.style.setProperty('--accent', `oklch(${clarte} 0.170 ${teinteHeure().toFixed(1)})`);
        };

        // Safari teinte ses barres avec cette valeur, et c'est ce qui fait
        // déborder le violet du pied de page dans la barre d'adresse quand on
        // ne la lui donne pas. Les deux déclarations conditionnelles du
        // document cèdent la place à une seule, sans condition : le visiteur
        // peut avoir choisi l'inverse de son système, et c'est son choix qui
        // doit se voir jusque dans le chrome du navigateur. On lit le papier
        // réellement appliqué plutôt qu'une table, pour que le mode encre
        // l'emporte aussi.
        const teintes = { light: '#f4f2ed', dark: '#1d1f21' };
        const poserBarre = () => {
          const root = document.documentElement;
          const papier = getComputedStyle(root).getPropertyValue('--paper').trim();
          const couleur = papier || teintes[root.dataset.swissTheme] || teintes.light;

          // Les deux déclarations restent en place, on ne fait qu'en réécrire
          // la valeur. Les retirer pour en poser une autre marchait dans le
          // navigateur, pas dans Safari : il lit la balise au chargement et ne
          // suit pas toujours son remplacement. Les deux portent désormais la
          // même couleur, celle du thème réellement appliqué — quelle que
          // soit celle qu'il retient, il retient la bonne.
          const balises = document.querySelectorAll('meta[name="theme-color"]');
          if (!balises.length) {
            const barre = document.createElement('meta');
            barre.name = 'theme-color';
            barre.setAttribute('content', couleur);
            document.head.append(barre);
            return;
          }
          for (const balise of balises) balise.setAttribute('content', couleur);
        };

        apply();
        document.addEventListener('astro:after-swap', apply);

        // Le défilement filé n'est armé qu'une fois la restauration passée :
        // sinon le navigateur glisse jusqu'à la position d'où l'on venait au
        // lieu de s'y poser.
        const armerDefilement = () => {
          requestAnimationFrame(() => document.documentElement.classList.add('pret'));
        };
        if (document.readyState === 'complete') armerDefilement();
        else addEventListener('load', armerDefilement, { once: true });

        // Le thème peut changer sans passer par ici — l'interrupteur du bas,
        // la touche du mode encre. On suit l'attribut plutôt que celui qui le
        // pose.
        new MutationObserver(() => {
          poserTeinte();
          poserBarre();
        }).observe(document.documentElement, {
          attributes: true,
          attributeFilter: ['data-swiss-theme', 'data-swiss-accent', 'class'],
        });

        // L'heure avance : la teinte suit, à la minute.
        setInterval(poserTeinte, 60000);

        // Le logo ne se trace qu'à la première page vue : le revoir se
        // dessiner à chaque navigation lasserait. Le drapeau est posé avant
        // le premier paint, sinon le logo paraîtrait entier le temps d'une
        // image avant de s'effacer.
        try {
          if (!sessionStorage.getItem('swiss-logo-vu')) {
            document.documentElement.classList.add('logo-draw');
            sessionStorage.setItem('swiss-logo-vu', '1');
          }
        } catch {}
      })();
    </script>

    <ClientRouter />
  </head>
  <body>
    <!-- Au clavier, il faut sinon traverser la barre entière avant d'atteindre
         la page. Le lien ne se voit qu'une fois atteint par la tabulation. -->
    <a href="#contenu" class="skip-link">Skip to content</a>

    <!-- Mesure d'audience Vercel : sans cookie, sans identifiant persistant,
         sans donnée personnelle. Le script n'existe que si la fonction est
         activée sur le projet. -->
    <script is:inline defer src="/_vercel/insights/script.js"></script>
    <SwissGrid />

    <slot />
    <SwissDock />
    <SwissLab />
    <SwissJeux />
    <SwissCursor client:idle />

    <script is:inline data-astro-rerun>
      // Grille : bouton dans l'en-tête, ou touche G. L'état est mémorisé.
      (() => {
        const overlay = document.querySelector('[data-grid-overlay]');
        const button = document.querySelector('[data-grid-toggle]');
        if (!overlay || !button) return;

        const apply = (on) => {
          overlay.hidden = !on;
          button.setAttribute('aria-pressed', String(on));
          button.setAttribute('aria-label', on ? 'Masquer la grille' : 'Afficher la grille');
          try {
            localStorage.setItem('swiss-grid', on ? '1' : '0');
          } catch {}
        };

        const toggle = () => {
          apply(overlay.hidden);
        };

        button.addEventListener('click', toggle);

        document.addEventListener('keydown', (event) => {
          // On ne détourne pas la touche pendant une saisie ni avec un modificateur.
          if (event.metaKey || event.ctrlKey || event.altKey) return;
          const tag = event.target?.tagName;
          if (tag === 'INPUT' || tag === 'TEXTAREA' || event.target?.isContentEditable) return;
          if (event.key === 'g' || event.key === 'G') toggle();
        });

        let garde = null;
        try {
          garde = localStorage.getItem('swiss-grid');
        } catch {}
        apply(garde === '1');
      })();

      // Apparition au défilement. Le drapeau n'est posé que si l'on anime
      // vraiment : sans script ou en mouvement réduit, rien n'est masqué.
      (() => {
        const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        const targets = document.querySelectorAll('[data-reveal]');
        if (reduced || !('IntersectionObserver' in window) || !targets.length) return;

        document.documentElement.dataset.revealReady = '';

        const observer = new IntersectionObserver(
          (entries) => {
            // Le décalage vient du rang dans la fournée, pas d'un numéro fixe :
            // au chargement, ce qui est déjà visible se déroule ; en cours de
            // défilement, une ligne qui arrive seule n'attend personne.
            const arriving = entries
              .filter((entry) => entry.isIntersecting)
              .sort((a, b) => a.boundingClientRect.top - b.boundingClientRect.top);

            arriving.forEach((entry, rank) => {
              const explicit = entry.target.dataset.revealDelay;
              const delay = explicit === undefined ? Math.min(rank, 3) * 60 : Number(explicit);
              setTimeout(() => entry.target.classList.add('is-in'), delay);
              observer.unobserve(entry.target);
            });
          },
          { rootMargin: '0px 0px -10% 0px', threshold: 0.05 }
        );

        // Filet de sécurité : au bas de la page, plus rien ne peut franchir la
        // ligne de déclenchement. Ce qui reste caché est montré.
        addEventListener(
          'scroll',
          () => {
            const bottom =
              innerHeight + scrollY >= document.documentElement.scrollHeight - 4;
            if (!bottom) return;
            for (const el of targets) {
              if (!el.classList.contains('is-in')) {
                el.classList.add('is-in');
                observer.unobserve(el);
              }
            }
          },
          { passive: true }
        );

        for (const el of targets) observer.observe(el);
      })();
    </script>
  <!-- Le titre répond au pointeur : chaque lettre s'épaissit d'autant plus
       qu'elle en est proche, et s'allège derrière lui. Les lettres sont
       découpées au chargement, pas dans le HTML, pour que le titre reste un
       titre si le script ne tourne pas. -->
  <script is:inline data-astro-rerun>
    (() => {
      const h1 = document.querySelector('h1.swiss-display');
      if (!h1) return;
      if (matchMedia('(prefers-reduced-motion: reduce)').matches) return;
      // Sans souris, c'est l'inclinaison du téléphone qui promène un pointeur
      // virtuel sur le titre.
      const souris = matchMedia('(pointer: fine)').matches;

      // Découpe en signes, les espaces restant du texte nu : une espace dans
      // un bloc en ligne se réduirait à rien.
      const glyphs = [];
      const split = (node) => {
        [...node.childNodes].forEach((child) => {
          if (child.nodeType === 3) {
            const frag = document.createDocumentFragment();
            for (const ch of child.textContent) {
              // Toute espace reste du texte nu, l'espace insécable et le
              // retour à la ligne du balisage compris : enfermée dans un bloc
              // en ligne, elle se réduirait à rien et laisserait un signe de
              // largeur nulle au début du titre.
              if (!ch.trim()) {
                precedent = null;
                frag.appendChild(document.createTextNode(ch));
              } else {
                const span = document.createElement('span');
                span.textContent = ch;
                span.style.display = 'inline-block';
                // Aligné par le haut de sa boîte et non par sa ligne de base :
                // la hauteur de la ligne ne dépend plus des métriques de la
                // graisse en cours, qui la faisaient varier de trois pixels.
                span.style.verticalAlign = 'top';
                frag.appendChild(span);
                const g = { el: span, ch, w: 700, tw: 700, painted: 700, avant: precedent };
                glyphs.push(g);
                precedent = g;
              }
            }
            child.replaceWith(frag);
          } else if (child.nodeName === 'BR') {
            precedent = null;
          } else {
            // Le point qui ferme le titre a cessé d'être une commande : c'est
            // un signe comme les autres, et il suit la graisse comme eux.
            split(child);
          }
        });
      };
      let precedent = null;
      split(h1);
      if (!glyphs.length) return;

      // Chaque ligne devient un bloc à part, à hauteur fixe. Chrome recalculait
      // parfois mal la hauteur d'une ligne faite de lettres en boîtes
      // séparées : souris posée sur la deuxième ligne, les deux dernières
      // descendaient d'un bloc de près de six pixels au moment où les
      // graisses se posaient, et remontaient à la moindre retouche. Une ligne
      // enfermée dans un bloc de hauteur fixe ne peut plus pousser la
      // suivante, quoi que le moteur calcule à l'intérieur.
      const lignesTitre = [];
      {
        let courante = null;
        const nouvelle = () => {
          courante = document.createElement('span');
          courante.className = 'titre-ligne';
          courante.style.cssText = 'display:block;white-space:nowrap';
          lignesTitre.push(courante);
        };
        nouvelle();
        for (const node of [...h1.childNodes]) {
          if (node.nodeName === 'BR') {
            node.remove();
            h1.appendChild(courante);
            nouvelle();
          } else {
            courante.appendChild(node);
          }
        }
        h1.appendChild(courante);
      }

      // Couper le titre en signes détruit le crénage : chaque lettre devient
      // une boîte à part, et les paires que la fonte resserre — TA, AL, AV —
      // ne se resserrent plus. La ligne « and digital » s'élargissait ainsi de
      // près de neuf pixels à l'instant où le script tournait : un saut à
      // l'arrivée. On relit donc le crénage de chaque paire dans la fonte elle-
      // même, sur une sonde hors champ, et on le rend en marge à la première
      // lettre. Le titre découpé retombe à la largeur du titre entier.
      const crener = () => {
        const cs = getComputedStyle(h1);
        const sonde = document.createElement('span');
        sonde.style.cssText =
          'position:absolute;visibility:hidden;white-space:pre;left:-9999px;top:0';
        for (const k of ['fontFamily', 'fontSize', 'fontWeight', 'letterSpacing', 'textTransform', 'fontFeatureSettings']) {
          sonde.style[k] = cs[k];
        }
        document.body.appendChild(sonde);
        const cache = new Map();
        const largeur = (t) => {
          if (!cache.has(t)) {
            sonde.textContent = t;
            cache.set(t, sonde.getBoundingClientRect().width);
          }
          return cache.get(t);
        };
        for (const g of glyphs) {
          if (g.avant) {
            const paire = g.avant.ch + g.ch;
            const k = largeur(paire) - largeur(g.avant.ch) - largeur(g.ch);
            g.avant.el.style.marginRight = Math.abs(k) > 0.05 ? `${k.toFixed(2)}px` : '';
          }
        }
        sonde.remove();
      };

      const REST = 700;
      // Au téléphone, le titre est petit : l'écart de graisse doit être plus
      // large pour se voir, et l'onde plus serrée pour ne pas couvrir toute
      // la ligne — une onde plus large que la ligne s'annule dans
      // l'équilibrage et le titre semble immobile.
      const LOW = souris ? 560 : 380;
      const PEAK = 900;

      let pointer = null;
      let frame = null;
      let dernier = 0;
      let boxes = [];
      let lignes = [];
      let sigma = 90;
      let creux = 162;
      let boite = null;

      // La géométrie de repos : le centre de chaque signe, en coordonnées de
      // page et non d'écran, pour qu'un défilement pendant le survol ne décale
      // pas l'onde des lettres. Elle se relève à l'entrée du pointeur, quand
      // tout est au repos, et au redimensionnement — jamais pendant l'effet :
      // les lettres poussent, et relire leurs centres en mouvement faisait
      // courir le titre après lui-même. La portée se calcule ici aussi, une
      // fois, au lieu de relire le style à chaque image.
      const measure = () => {
        const size = parseFloat(getComputedStyle(h1).fontSize);
        sigma = souris ? Math.max(90, size * 0.55) : size * 0.8;
        creux = sigma * 1.8;
        boxes = glyphs.map(({ el }) => {
          const r = el.getBoundingClientRect();
          return { cx: r.left + r.width / 2 + scrollX, cy: r.top + r.height / 2 + scrollY };
        });
        const par = new Map();
        boxes.forEach((b, i) => {
          const cle = Math.round(b.cy / 8);
          if (!par.has(cle)) par.set(cle, []);
          par.get(cle).push(i);
        });
        lignes = [...par.values()];
        // La boîte du titre, en coordonnées de page.
        const r = h1.getBoundingClientRect();
        boite = {
          l: r.left + scrollX,
          r: r.right + scrollX,
          t: r.top + scrollY,
          b: r.bottom + scrollY,
        };
      };

      // Le titre garde sa hauteur de repos, écrite en dur. Quelle que soit la
      // graisse de ses lettres, la page sous lui ne bouge plus d'un pixel :
      // la ligne de section, la vitrine et tout le reste restent en place.
      const figerHauteur = () => {
        h1.style.height = '';
        for (const l of lignesTitre) l.style.height = '';
        const hauteurs = lignesTitre.map((l) => l.getBoundingClientRect().height);
        lignesTitre.forEach((l, i) => {
          l.style.height = `${hauteurs[i]}px`;
        });
        h1.style.height = `${h1.getBoundingClientRect().height}px`;
      };

      // Chaque signe s'épaissit sous le pointeur et s'allège tout autour. Le
      // creux a un fond : loin du geste, les lettres restent au repos. Et
      // l'effet s'éteint dès qu'on quitte le texte, même en restant dans le
      // bloc du titre, plus large que sa ligne la plus courte.
      const cibler = () => {
        let porte = 0;
        if (pointer && boxes.length) {
          let pres = Infinity;
          for (const b of boxes) {
            const dx = pointer.x - b.cx;
            const dy = pointer.y - b.cy;
            pres = Math.min(pres, dx * dx + dy * dy);
          }
          porte = Math.exp(-pres / (2 * sigma * sigma));
        }

        glyphs.forEach((g, i) => {
          if (porte < 0.002) {
            g.tw = REST;
            return;
          }
          const dx = pointer.x - boxes[i].cx;
          const dy = pointer.y - boxes[i].cy;
          const d2 = dx * dx + dy * dy;
          const d = Math.sqrt(d2);
          const bosse = Math.exp(-d2 / (2 * sigma * sigma));
          const fosse = (d / creux) * Math.exp(0.5 - d2 / (2 * creux * creux));
          g.tw = REST + porte * (bosse * (PEAK - REST) - fosse * (REST - LOW));
        });

        // Chaque ligne garde sa graisse moyenne : ce que le renflement prend
        // en largeur, le creux le rend, et la fin de ligne ne glisse pas.
        for (const ligne of lignes) {
          let somme = 0;
          for (const i of ligne) somme += glyphs[i].tw - REST;
          const ecart = somme / ligne.length;
          for (const i of ligne) glyphs[i].tw -= ecart;
        }
        // La fonte ne va pas au-delà de 100 et 900.
        for (const g of glyphs) g.tw = Math.min(900, Math.max(100, g.tw));
      };

      // Le rattrapage est réglé sur le temps, pas sur les images : un pas fixe
      // par image allait deux fois plus vite sur un écran à 120 Hz, et traînait
      // près d'une demi-seconde derrière la souris à 60 Hz. Constante de
      // soixante-dix millisecondes : la graisse suit la main sans à-coup.
      const TAU = 70;
      // En sortant du titre, les lettres ne reviennent pas au rythme du geste
      // mais plus lentement : le titre se repose au lieu de se recomposer d'un
      // coup. C'est cette lenteur-là, et non une zone élargie autour du
      // titre, qui efface le saut à la sortie — la zone élargie faisait
      // réagir le titre au-dessus du vide et des images.
      const TAU_SORTIE = 420;

      const tick = (maintenant) => {
        const dt = Math.min(64, maintenant - (dernier || maintenant - 16));
        dernier = maintenant;
        const k = 1 - Math.exp(-dt / (pointer ? TAU : TAU_SORTIE));

        let moving = false;
        for (const g of glyphs) {
          g.w += (g.tw - g.w) * k;
          if (Math.abs(g.w - g.tw) > 0.5) moving = true;
          else g.w = g.tw;
          const rounded = Math.round(g.w);
          // Toute graisse écrite recalcule la mise en page du titre : on
          // n'écrit que si la valeur a changé d'un cran entier.
          if (rounded !== g.painted) {
            g.painted = rounded;
            g.el.style.fontWeight = String(rounded);
          }
        }

        // La boucle s'arrête dès que tout est posé, pointeur immobile ou non ;
        // le prochain mouvement la relance.
        if (moving) {
          frame = requestAnimationFrame(tick);
        } else {
          frame = null;
          dernier = 0;
        }
      };

      const relancer = () => {
        cibler();
        if (frame === null) frame = requestAnimationFrame(tick);
      };

      // Le pointeur est lu sur toute la page, mais l'effet ne joue que dans la
      // boîte du titre. Au-dessus du vide qui le sépare de la vitrine, et sur
      // la vitrine elle-même, le titre ne bouge plus ; en sortant, il revient
      // lentement au repos au lieu de se recomposer d'un coup.
      const auRepos = () => frame === null && glyphs.every((g) => g.painted === REST);

      addEventListener(
        'pointermove',
        (event) => {
          if (event.pointerType && event.pointerType !== 'mouse' && event.pointerType !== 'pen') return;
          const x = event.pageX;
          const y = event.pageY;
          if (!boite) measure();
          // L'effet ne joue que sur le titre lui-même.
          const dedans = x > boite.l && x < boite.r && y > boite.t && y < boite.b;
          // En entrant dans le titre, tout est posé : c'est le moment de relever
          // la géométrie sans la fausser. Ailleurs sur la page, on ne mesure
          // rien.
          if (dedans && !pointer && auRepos()) measure();
          if (!dedans) {
            if (pointer) {
              pointer = null;
              relancer();
            }
            return;
          }
          pointer = { x, y };
          relancer();
        },
        { passive: true },
      );

      // Au doigt : c'est l'inclinaison du téléphone qui promène un point sur
      // le titre. Pencher à gauche ou à droite le fait courir le long des
      // lignes ; pencher vers soi ou vers l'avant le fait passer d'une ligne
      // à l'autre. La position de départ sert de repos, et elle se recale
      // doucement : un téléphone qu'on garde penché finit par être « droit ».
      if (!souris) {
        let repere = null;
        const borne = (v) => Math.max(-1, Math.min(1, v));

        const incliner = (event) => {
          if (event.gamma == null || event.beta == null) return;
          // En paysage, les axes du téléphone tournent avec l'écran.
          const angle = (screen.orientation?.angle ?? window.orientation ?? 0) % 360;
          let gauche = event.gamma;
          let avant = event.beta;
          if (angle === 90) [gauche, avant] = [event.beta, -event.gamma];
          else if (angle === 270 || angle === -90) [gauche, avant] = [-event.beta, event.gamma];
          else if (angle === 180) [gauche, avant] = [-event.gamma, -event.beta];

          if (!repere) repere = { gauche, avant };
          repere.gauche += (gauche - repere.gauche) * 0.004;
          repere.avant += (avant - repere.avant) * 0.004;

          // Le titre hors de l'écran ne joue pas.
          const r = h1.getBoundingClientRect();
          if (r.bottom < 0 || r.top > innerHeight) {
            if (pointer) {
              pointer = null;
              relancer();
            }
            return;
          }
          if (!pointer && auRepos()) measure();

          // Douze degrés d'inclinaison suffisent pour parcourir le titre.
          const x = borne((gauche - repere.gauche) / 12);
          const y = borne((avant - repere.avant) / 12);
          // Téléphone tenu droit : le titre se repose.
          if (Math.abs(x) < 0.06 && Math.abs(y) < 0.06) {
            if (pointer) {
              pointer = null;
              relancer();
            }
            return;
          }
          pointer = {
            x: boite.l + ((boite.r - boite.l) * (1 + x)) / 2,
            y: boite.t + ((boite.b - boite.t) * (1 + y)) / 2,
          };
          relancer();
        };

        // On écoute d'emblée : Android envoie l'inclinaison sans rien
        // demander. Safari sur iPhone, lui, n'envoie rien tant que le
        // visiteur n'a pas donné sa permission, et ne la demande qu'à la
        // suite d'un toucher. Le premier toucher de la page la réclame — le
        // titre seul ne suffisait pas : iOS n'y déclenche pas de clic, ce
        // n'est pas un élément qu'on touche. On redemande tant qu'aucune
        // réponse n'est venue. Écouter deux fois ne double rien, le
        // navigateur ignore le doublon.
        const ecouter = () => addEventListener('deviceorientation', incliner, { passive: true });
        if ('DeviceOrientationEvent' in window) ecouter();
        const demande = window.DeviceOrientationEvent?.requestPermission;
        if (typeof demande === 'function') {
          let repondu = false;
          const demander = () => {
            if (repondu) return;
            // L'inclinaison et le mouvement se demandent dans le même geste :
            // iOS n'affiche qu'une fenêtre pour les deux. Le mouvement sert à
            // la pluie de formes qu'on déclenche en secouant le téléphone.
            const mouvement = window.DeviceMotionEvent?.requestPermission;
            Promise.all([
              demande.call(DeviceOrientationEvent),
              typeof mouvement === 'function'
                ? mouvement.call(DeviceMotionEvent).catch(() => 'denied')
                : 'granted',
            ])
              .then(([etat, etatMouvement]) => {
                repondu = true;
                removeEventListener('touchend', demander);
                if (etat === 'granted') ecouter();
                if (etatMouvement === 'granted') dispatchEvent(new Event('mouvement-autorise'));
              })
              .catch(() => {});
          };
          addEventListener('touchend', demander, { passive: true });
        }
      }

      // La souris quitte la fenêtre : on repose tout.
      document.documentElement.addEventListener('pointerleave', () => {
        if (!pointer) return;
        pointer = null;
        relancer();
      });

      // Au redimensionnement, les lettres reviennent au repos d'abord : on ne
      // relève pas une géométrie déformée.
      addEventListener('resize', () => {
        pointer = null;
        for (const g of glyphs) {
          g.w = g.tw = g.painted = REST;
          g.el.style.fontWeight = '';
        }
        crener();
        figerHauteur();
        measure();
      });

      const installer = () => {
        crener();
        figerHauteur();
      };
      if (document.fonts?.ready) document.fonts.ready.then(installer);
      else installer();
    })();
  </script>
  </body>
</html>
