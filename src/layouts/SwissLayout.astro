---
import { ClientRouter } from 'astro:transitions';
import '../styles/swiss.css';
import SwissCursor from '../components/SwissCursor.jsx';
import SwissGrid from '../components/SwissGrid.astro';
import SwissDock from '../components/SwissDock.astro';
import SwissLab from '../components/SwissLab.astro';

interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
}

const {
  title = 'Laurent Nyssen — Multidisciplinary Designer',
  description = "I'm a Brussels-based designer creating bold identities and digital experiences through creative direction, strategy, branding and UX/UI with AI used where it truly adds value.",
  noindex = false,
} = Astro.props;

// Fiche structurée, posée sur la seule page d'accueil : c'est elle qui
// représente la personne, la répéter sur chaque page n'ajoute rien.
const person = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Laurent Nyssen',
  alternateName: 'LN',
  jobTitle: 'Multidisciplinary Designer',
  url: 'https://laurentnyssen.be',
  email: 'mailto:hello@laurentnyssen.be',
  telephone: '+32497305080',
  address: {
    '@type': 'PostalAddress',
    addressLocality: 'Brussels',
    addressCountry: 'BE',
  },
  knowsAbout: [
    'Brand strategy',
    'Creative direction',
    'Visual identity',
    'UX/UI design',
    'Editorial and print design',
    'Design systems',
  ],
  sameAs: [
    'https://www.linkedin.com/in/laurentnyssen/',
    'https://www.instagram.com/lepolographe/',
    'https://open.spotify.com/user/116697393',
  ],
};

// Adresses absolues : les réseaux sociaux refusent les chemins relatifs.
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ogImage = new URL('/og.png', Astro.site).href;
---

<html lang="en" class="swiss" data-swiss-theme="light">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <link rel="canonical" href={canonical} />
    {
      Astro.url.pathname === '/' && (
        <script type="application/ld+json" set:html={JSON.stringify(person)} />
      )
    }
    {noindex && <meta name="robots" content="noindex" />}

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Laurent Nyssen" />
    <meta property="og:locale" content="en_GB" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Laurent Nyssen — Multidisciplinary Designer" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <meta name="theme-color" content="#141414" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <!-- Un seul fichier porte toutes les graisses, demandé avant que le CSS
         ne le réclame. Sans cela le texte s'affiche d'abord dans la police de
         secours puis change de largeur. `crossorigin` est obligatoire, une
         police se charge en anonyme et le préchargement serait sinon perdu. -->
    <link rel="preload" as="font" type="font/woff2" href="/fonts/switzer-variable.woff2" crossorigin />
    <script is:inline>
      // Thème appliqué avant le premier paint pour éviter le flash. Une
      // transition de vue remplace le document et ses attributs : on repose
      // le thème avant que la nouvelle page ne s'affiche, sinon elle
      // apparaîtrait en clair le temps d'une image.
      (() => {
        const apply = () => {
          const root = document.documentElement;
          const stored = localStorage.getItem('swiss-theme');
          root.dataset.swissTheme =
            stored ?? (matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');

          // La teinte d'accent choisie par le visiteur, posée ici pour la
          // même raison que le thème : appliquée après coup, la page
          // paraîtrait violette le temps d'une image.
          const teinte = localStorage.getItem('swiss-accent');
          if (teinte) root.dataset.swissAccent = teinte;
          else delete root.dataset.swissAccent;

          // Le disque remplace la flèche : on la masque dès maintenant, aux
          // seules conditions où le disque existera.
          if (
            matchMedia('(pointer: fine)').matches &&
            !matchMedia('(prefers-reduced-motion: reduce)').matches
          ) {
            root.dataset.swissCursor = '';
          }
        };
        apply();
        document.addEventListener('astro:after-swap', apply);

        // Le logo ne se trace qu'à la première page vue : le revoir se
        // dessiner à chaque navigation lasserait. Le drapeau est posé avant
        // le premier paint, sinon le logo paraîtrait entier le temps d'une
        // image avant de s'effacer.
        try {
          if (!sessionStorage.getItem('swiss-logo-vu')) {
            document.documentElement.classList.add('logo-draw');
            sessionStorage.setItem('swiss-logo-vu', '1');
          }
        } catch {}
      })();
    </script>

    <ClientRouter />
  </head>
  <body>
    <!-- Mesure d'audience Vercel : sans cookie, sans identifiant persistant,
         sans donnée personnelle. Le script n'existe que si la fonction est
         activée sur le projet. -->
    <script is:inline defer src="/_vercel/insights/script.js"></script>
    <SwissGrid />

    <slot />
    <SwissDock />
    <SwissLab />
    <SwissCursor client:idle />

    <script is:inline data-astro-rerun>
      // Grille : bouton dans l'en-tête, ou touche G. L'état est mémorisé.
      (() => {
        const overlay = document.querySelector('[data-grid-overlay]');
        const button = document.querySelector('[data-grid-toggle]');
        if (!overlay || !button) return;

        const apply = (on) => {
          overlay.hidden = !on;
          button.setAttribute('aria-pressed', String(on));
          button.setAttribute('aria-label', on ? 'Masquer la grille' : 'Afficher la grille');
          localStorage.setItem('swiss-grid', on ? '1' : '0');
        };

        const toggle = () => {
          apply(overlay.hidden);
        };

        button.addEventListener('click', toggle);

        document.addEventListener('keydown', (event) => {
          // On ne détourne pas la touche pendant une saisie ni avec un modificateur.
          if (event.metaKey || event.ctrlKey || event.altKey) return;
          const tag = event.target?.tagName;
          if (tag === 'INPUT' || tag === 'TEXTAREA' || event.target?.isContentEditable) return;
          if (event.key === 'g' || event.key === 'G') toggle();
        });

        apply(localStorage.getItem('swiss-grid') === '1');
      })();

      // Apparition au défilement. Le drapeau n'est posé que si l'on anime
      // vraiment : sans script ou en mouvement réduit, rien n'est masqué.
      (() => {
        const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        const targets = document.querySelectorAll('[data-reveal]');
        if (reduced || !('IntersectionObserver' in window) || !targets.length) return;

        document.documentElement.dataset.revealReady = '';

        const observer = new IntersectionObserver(
          (entries) => {
            // Le décalage vient du rang dans la fournée, pas d'un numéro fixe :
            // au chargement, ce qui est déjà visible se déroule ; en cours de
            // défilement, une ligne qui arrive seule n'attend personne.
            const arriving = entries
              .filter((entry) => entry.isIntersecting)
              .sort((a, b) => a.boundingClientRect.top - b.boundingClientRect.top);

            arriving.forEach((entry, rank) => {
              const explicit = entry.target.dataset.revealDelay;
              const delay = explicit === undefined ? Math.min(rank, 3) * 60 : Number(explicit);
              setTimeout(() => entry.target.classList.add('is-in'), delay);
              observer.unobserve(entry.target);
            });
          },
          { rootMargin: '0px 0px -10% 0px', threshold: 0.05 }
        );

        // Filet de sécurité : au bas de la page, plus rien ne peut franchir la
        // ligne de déclenchement. Ce qui reste caché est montré.
        addEventListener(
          'scroll',
          () => {
            const bottom =
              innerHeight + scrollY >= document.documentElement.scrollHeight - 4;
            if (!bottom) return;
            for (const el of targets) {
              if (!el.classList.contains('is-in')) {
                el.classList.add('is-in');
                observer.unobserve(el);
              }
            }
          },
          { passive: true }
        );

        for (const el of targets) observer.observe(el);
      })();
    </script>
  <!-- Le titre répond au pointeur : chaque lettre s'épaissit d'autant plus
       qu'elle en est proche, et s'allège derrière lui. Les lettres sont
       découpées au chargement, pas dans le HTML, pour que le titre reste un
       titre si le script ne tourne pas. -->
  <script is:inline data-astro-rerun>
    (() => {
      const h1 = document.querySelector('h1.swiss-display');
      if (!h1) return;
      if (!matchMedia('(pointer: fine)').matches) return;
      if (matchMedia('(prefers-reduced-motion: reduce)').matches) return;

      // Découpe en signes, les espaces restant du texte nu : une espace dans
      // un bloc en ligne se réduirait à rien.
      const glyphs = [];
      const split = (node) => {
        [...node.childNodes].forEach((child) => {
          if (child.nodeType === 3) {
            const frag = document.createDocumentFragment();
            for (const ch of child.textContent) {
              if (ch === ' ') {
                frag.appendChild(document.createTextNode(ch));
              } else {
                const span = document.createElement('span');
                span.textContent = ch;
                span.style.display = 'inline-block';
                frag.appendChild(span);
                glyphs.push({ el: span, w: 700, tw: 700, painted: 700 });
              }
            }
            child.replaceWith(frag);
          } else if (child.nodeName !== 'BR') {
            split(child);
          }
        });
      };
      split(h1);
      if (!glyphs.length) return;

      let pointer = null;
      let frame = null;
      let boxes = [];

      const measure = () => {
        boxes = glyphs.map(({ el }) => {
          const r = el.getBoundingClientRect();
          return { cx: r.left + r.width / 2, cy: r.top + r.height / 2 };
        });
      };

      // Switzer est variable : au lieu de déplacer les lettres, on en change
      // la graisse. Elles s'épaississent au passage du pointeur et poussent
      // leurs voisines, puis reviennent. C'est la typographie qui réagit en
      // tant que typographie.
      const REST = 700;
      const LOW = 560;
      const PEAK = 900;

      const tick = () => {
        const size = parseFloat(getComputedStyle(h1).fontSize);
        const sigma = Math.max(90, size * 0.55);

        let moving = false;

        glyphs.forEach((g, i) => {
          if (pointer && boxes[i]) {
            const dx = pointer.x - boxes[i].cx;
            const dy = pointer.y - boxes[i].cy;
            const f = Math.exp(-(dx * dx + dy * dy) / (2 * sigma * sigma));
            g.tw = LOW + f * (PEAK - LOW);
          } else {
            g.tw = REST;
          }

          g.w += (g.tw - g.w) * 0.16;

          if (Math.abs(g.w - g.tw) > 0.5) moving = true;
          const rounded = Math.round(g.w);
          // Changer la graisse recalcule la mise en page : on ne réécrit que
          // si la valeur a bougé d'un cran entier.
          if (rounded !== g.painted) {
            g.painted = rounded;
            g.el.style.fontWeight = String(rounded);
          }
        });

        // Les largeurs ont changé, donc les centres aussi.
        if (pointer) measure();

        if (pointer || moving) {
          frame = requestAnimationFrame(tick);
        } else {
          frame = null;
        }
      };

      const start = () => {
        if (frame === null) frame = requestAnimationFrame(tick);
      };

      h1.addEventListener('pointerenter', () => {
        measure();
        start();
      });

      h1.addEventListener('pointermove', (event) => {
        pointer = { x: event.clientX, y: event.clientY };
        start();
      });

      h1.addEventListener('pointerleave', () => {
        pointer = null;
        start();
      });

      addEventListener('resize', measure);
    })();
  </script>
  </body>
</html>
