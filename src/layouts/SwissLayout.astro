---
import '../styles/swiss.css';
import SwissCursor from '../components/SwissCursor.jsx';
import SwissGrid from '../components/SwissGrid.astro';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Laurent Nyssen — Multidisciplinary Designer',
  description = "I'm a Brussels-based designer creating bold identities and digital experiences through creative direction, strategy, branding and UX/UI with AI used where it truly adds value.",
} = Astro.props;

// Adresses absolues : les réseaux sociaux refusent les chemins relatifs.
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ogImage = new URL('/og.png', Astro.site).href;
---

<html lang="en" class="swiss" data-swiss-theme="light">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <link rel="canonical" href={canonical} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Laurent Nyssen" />
    <meta property="og:locale" content="en_GB" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Laurent Nyssen — Multidisciplinary Designer" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <meta name="theme-color" content="#141414" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <script is:inline>
      // Thème appliqué avant le premier paint pour éviter le flash.
      const stored = localStorage.getItem('swiss-theme');
      document.documentElement.dataset.swissTheme =
        stored ?? (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
    </script>
  </head>
  <body>
    <SwissGrid />

    <slot />
    <SwissCursor client:idle />

    <script is:inline>
      // Grille : bouton dans l'en-tête, ou touche G. L'état est mémorisé.
      (() => {
        const overlay = document.querySelector('[data-grid-overlay]');
        const button = document.querySelector('[data-grid-toggle]');
        if (!overlay || !button) return;

        const apply = (on) => {
          overlay.hidden = !on;
          button.setAttribute('aria-pressed', String(on));
          button.setAttribute('aria-label', on ? 'Masquer la grille' : 'Afficher la grille');
          localStorage.setItem('swiss-grid', on ? '1' : '0');
        };

        // Cartouche : ce que la page mesure réellement à cet instant.
        const readout = () => {
          const col = overlay.querySelector('.grid-col:not(.hidden)');
          const w = window.innerWidth;
          const set = (sel, value) => {
            const node = overlay.querySelector(sel);
            if (node) node.textContent = value;
          };
          set('[data-grid-vw]', `${w}px`);
          set('[data-grid-bp]', w >= 900 ? 'DESKTOP' : w >= 768 ? 'TABLET' : 'MOBILE');
          set('[data-grid-cols]', `${w >= 900 ? 12 : 6} col`);
          set('[data-grid-colw]', col ? `${col.getBoundingClientRect().width.toFixed(1)}px` : '—');
        };

        const toggle = () => {
          const on = overlay.hidden;
          apply(on);
          if (on) readout();
        };

        window.addEventListener('resize', () => {
          if (!overlay.hidden) readout();
        });

        button.addEventListener('click', toggle);

        document.addEventListener('keydown', (event) => {
          // On ne détourne pas la touche pendant une saisie ni avec un modificateur.
          if (event.metaKey || event.ctrlKey || event.altKey) return;
          const tag = event.target?.tagName;
          if (tag === 'INPUT' || tag === 'TEXTAREA' || event.target?.isContentEditable) return;
          if (event.key === 'g' || event.key === 'G') toggle();
        });

        const stored = localStorage.getItem('swiss-grid') === '1';
        apply(stored);
        if (stored) readout();
      })();

      // Les intitulés de colonne se calent sur le haut des capitales du texte
      // qu'ils annoncent. Les corps vont de 11 à 48px, donc aucune règle CSS
      // ne donne le même résultat partout : on mesure.
      (() => {
        const labels = [...document.querySelectorAll('.section-label')];
        if (!labels.length) return;

        const contexte = document.createElement('canvas').getContext('2d');

        // Hauteur de capitale réelle de la police employée, en pixels.
        const hauteurCapitale = (style) => {
          contexte.font = `${style.fontWeight} ${style.fontSize} ${style.fontFamily}`;
          return contexte.measureText('H').actualBoundingBoxAscent;
        };

        // Une boîte en ligne de hauteur nulle s'assied sur la ligne de base :
        // son bord supérieur la donne exactement.
        const hautDesCapitales = (el) => {
          const marcheur = document.createTreeWalker(el, NodeFilter.SHOW_TEXT, {
            acceptNode: (n) => (n.textContent.trim() ? 1 : 2),
          });
          const noeud = marcheur.nextNode();
          if (!noeud) return null;

          const porteur = noeud.parentElement;
          const sonde = document.createElement('span');
          sonde.style.cssText =
            'display:inline-block;width:0;height:0;vertical-align:baseline';
          porteur.insertBefore(sonde, noeud);
          const ligneDeBase = sonde.getBoundingClientRect().top;
          sonde.remove();

          return ligneDeBase - hauteurCapitale(getComputedStyle(porteur));
        };

        const aligner = () => {
          // Les blocs en attente d'apparition sont translatés : on les remet à
          // plat le temps de mesurer, sinon on cale sur une position provisoire.
          const suspendus = [...document.querySelectorAll('[data-reveal]')].map((el) => {
            const avant = el.style.transform;
            el.style.transform = 'none';
            return [el, avant];
          });

          for (const label of labels) {
            label.style.top = '';
            const voisin = [...label.parentElement.children].find((c) => c !== label);
            if (!voisin) continue;
            const a = hautDesCapitales(label);
            const b = hautDesCapitales(voisin);
            if (a === null || b === null) continue;
            const ecart = b - a;
            // Décalage en position relative, pas en marge : sur un élément de
            // grille, une marge agrandit la rangée et emporte le voisin avec.
            if (Math.abs(ecart) > 0.5) {
              label.style.position = 'relative';
              label.style.top = `${ecart.toFixed(2)}px`;
            }
          }

          for (const [el, avant] of suspendus) el.style.transform = avant;
        };

        const lancer = () => requestAnimationFrame(aligner);
        if (document.fonts?.ready) document.fonts.ready.then(lancer);
        else lancer();
        window.addEventListener('resize', lancer);
      })();

      // Apparition au défilement. Le drapeau n'est posé que si l'on anime
      // vraiment : sans script ou en mouvement réduit, rien n'est masqué.
      (() => {
        const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        const targets = document.querySelectorAll('[data-reveal]');
        if (reduced || !('IntersectionObserver' in window) || !targets.length) return;

        document.documentElement.dataset.revealReady = '';

        const observer = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (!entry.isIntersecting) continue;
              // Léger décalage entre voisins pour que ça se déroule.
              const delay = Number(entry.target.dataset.revealDelay || 0);
              setTimeout(() => entry.target.classList.add('is-in'), delay);
              observer.unobserve(entry.target);
            }
          },
          { rootMargin: '0px 0px -12% 0px', threshold: 0.06 }
        );

        for (const el of targets) observer.observe(el);
      })();
    </script>
  </body>
</html>
