---
import '../styles/swiss.css';
import SwissCursor from '../components/SwissCursor.jsx';
import SwissGrid from '../components/SwissGrid.astro';

interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
}

const {
  title = 'Laurent Nyssen — Multidisciplinary Designer',
  description = "I'm a Brussels-based designer creating bold identities and digital experiences through creative direction, strategy, branding and UX/UI with AI used where it truly adds value.",
  noindex = false,
} = Astro.props;

// Adresses absolues : les réseaux sociaux refusent les chemins relatifs.
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ogImage = new URL('/og.png', Astro.site).href;
---

<html lang="en" class="swiss" data-swiss-theme="light">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Laurent Nyssen" />
    <meta property="og:locale" content="en_GB" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Laurent Nyssen — Multidisciplinary Designer" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <meta name="theme-color" content="#141414" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <!-- Les deux graisses visibles d'emblée, demandées avant que le CSS ne les
         réclame. Sans cela le texte s'affiche d'abord dans la police de
         secours puis change de largeur : le cadre de « Get in touch » se
         rétrécissait sous l'œil. `crossorigin` est obligatoire, une police se
         charge en anonyme et le préchargement serait sinon perdu. -->
    <link rel="preload" as="font" type="font/woff2" href="/fonts/switzer-400.woff2" crossorigin />
    <link rel="preload" as="font" type="font/woff2" href="/fonts/switzer-700.woff2" crossorigin />
    <script is:inline>
      // Thème appliqué avant le premier paint pour éviter le flash.
      const stored = localStorage.getItem('swiss-theme');
      document.documentElement.dataset.swissTheme =
        stored ?? (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
    </script>
  </head>
  <body>
    <!-- Mesure d'audience Vercel : sans cookie, sans identifiant persistant,
         sans donnée personnelle. Le script n'existe que si la fonction est
         activée sur le projet. -->
    <script is:inline defer src="/_vercel/insights/script.js"></script>
    <SwissGrid />

    <slot />
    <SwissCursor client:idle />

    <script is:inline>
      // Grille : bouton dans l'en-tête, ou touche G. L'état est mémorisé.
      (() => {
        const overlay = document.querySelector('[data-grid-overlay]');
        const button = document.querySelector('[data-grid-toggle]');
        if (!overlay || !button) return;

        const apply = (on) => {
          overlay.hidden = !on;
          button.setAttribute('aria-pressed', String(on));
          button.setAttribute('aria-label', on ? 'Masquer la grille' : 'Afficher la grille');
          localStorage.setItem('swiss-grid', on ? '1' : '0');
        };

        // Cartouche : ce que la page mesure réellement à cet instant.
        const readout = () => {
          const col = overlay.querySelector('.grid-col:not(.hidden)');
          const w = window.innerWidth;
          const set = (sel, value) => {
            const node = overlay.querySelector(sel);
            if (node) node.textContent = value;
          };
          set('[data-grid-vw]', `${w}px`);
          set('[data-grid-bp]', w >= 900 ? 'DESKTOP' : w >= 768 ? 'TABLET' : 'MOBILE');
          set('[data-grid-cols]', `${w >= 900 ? 12 : 6} col`);
          set('[data-grid-colw]', col ? `${col.getBoundingClientRect().width.toFixed(1)}px` : '—');
        };

        const toggle = () => {
          const on = overlay.hidden;
          apply(on);
          if (on) readout();
        };

        window.addEventListener('resize', () => {
          if (!overlay.hidden) readout();
        });

        button.addEventListener('click', toggle);

        document.addEventListener('keydown', (event) => {
          // On ne détourne pas la touche pendant une saisie ni avec un modificateur.
          if (event.metaKey || event.ctrlKey || event.altKey) return;
          const tag = event.target?.tagName;
          if (tag === 'INPUT' || tag === 'TEXTAREA' || event.target?.isContentEditable) return;
          if (event.key === 'g' || event.key === 'G') toggle();
        });

        const stored = localStorage.getItem('swiss-grid') === '1';
        apply(stored);
        if (stored) readout();
      })();

      // Apparition au défilement. Le drapeau n'est posé que si l'on anime
      // vraiment : sans script ou en mouvement réduit, rien n'est masqué.
      (() => {
        const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        const targets = document.querySelectorAll('[data-reveal]');
        if (reduced || !('IntersectionObserver' in window) || !targets.length) return;

        document.documentElement.dataset.revealReady = '';

        const observer = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (!entry.isIntersecting) continue;
              // Léger décalage entre voisins pour que ça se déroule.
              const delay = Number(entry.target.dataset.revealDelay || 0);
              setTimeout(() => entry.target.classList.add('is-in'), delay);
              observer.unobserve(entry.target);
            }
          },
          { rootMargin: '0px 0px -12% 0px', threshold: 0.06 }
        );

        for (const el of targets) observer.observe(el);
      })();
    </script>
  </body>
</html>
