---
import { getCollection, render } from 'astro:content';
import SwissLayout from '../layouts/SwissLayout.astro';
import SwissHeader from '../components/SwissHeader.astro';
import SwissFooter from '../components/SwissFooter.astro';
import also from '../data/also.json';
import SwissArrow from '../components/SwissArrow.astro';
import SwissFilmstrip from '../components/SwissFilmstrip.astro';
import { Picture } from 'astro:assets';
import { resolveImage } from '../lib/images';

const projects = (await getCollection('projects')).sort(
  (a, b) => a.data.order - b.data.order
);

// Le corps markdown est optionnel : on ne rend le composant que s'il y a du
// texte, sinon la planche reste seule.
const rendered = await Promise.all(
  projects.map(async (project) => {
    const { Content, remarkPluginFrontmatter } = await render(project);
    // Un projet sans texte ne doit pas ouvrir un bloc vide.
    const hasBody = Boolean((project.body ?? '').trim());
    const slug = String(project.data.slug ?? (project as any).slug ?? project.id).replace(/\.md$/, '');
    return { project, slug, Body: hasBody ? Content : null, remarkPluginFrontmatter };
  })
);

// La bande d'images : le premier visuel de chaque projet, dans l'ordre de
// l'index. C'est ce qu'on voit en arrivant, avant même d'ouvrir une ligne.
const vitrine = rendered
  .map(({ project, slug }) => {
    const premiere = project.data.images?.[0];
    return {
      slug,
      title: project.data.title,
      asset: resolveImage(typeof premiere === 'string' ? premiere : premiere?.src),
    };
  })
  .filter((v) => v.asset !== null);

const skills = [
  'Brand Strategy',
  'Creative Direction',
  'UX/UI Design',
  'Visual Identity',
  'AI Powered Design',
  'Editorial & Print',
  'Design Systems',
];

// Ce que voient les réseaux sociaux quand on partage l'adresse.
const pageTitle = 'Laurent Nyssen — Multidisciplinary Designer';
const pageDescription =
  "I'm Laurent Nyssen, a Brussels-based designer creating bold identities and digital experiences through creative direction, strategy, branding and UX/UI with AI used where it truly adds value.";

// Le bouton affiche l'adresse plutôt qu'un verbe : plus court, et il dit où
// l'on va. Sans protocole, sans www, sans barre oblique finale.
function domainLabel(link: string) {
  try {
    const url = new URL(link);
    const host = url.hostname.replace(/^www\./, '');
    const path = url.pathname.replace(/\/$/, '');
    return host + path;
  } catch {
    return link;
  }
}
---

<SwissLayout title={pageTitle} description={pageDescription}>
  <SwissHeader current="index" />

  <main id="contenu" tabindex="-1">
    <!-- Titre pleine largeur, calé au filet. -->
    <section class="swiss-shell section-ouverture">
      <h1 class="swiss-display" data-reveal data-reveal-slow>
        Bold brands.<br />Human <br class="titre-coupe" />experiences<span class="titre-point">.</span>
      </h1>

      <!-- Vitrine : une bande de visuels, un par projet, qui défile comme la
           bande des compétences et ralentit de même au survol. Posée juste
           sous le titre : placée sous la présentation, elle commençait à
           964 px sur un écran de 800 — on arrivait toujours sans une image.
           Un visuel mène à sa ligne, qui s'ouvre. La bande est doublée pour
           boucler sans couture ; la copie est cachée aux lecteurs d'écran. -->
      <div class="vitrine relative border-t border-[var(--rule)]" role="region" aria-label="Project preview" data-reveal data-reveal-slow data-reveal-delay="80">
        <!-- La bande avance seule : il faut pouvoir l'arrêter, et pas
             seulement en la survolant ou en y entrant au clavier. La commande
             se voit, se prend au doigt comme au clavier, et dit son état. Elle
             se retire quand le système demande moins de mouvement : la bande
             ne bouge alors pas, il n'y a rien à arrêter. -->
        <button
          type="button"
          data-vitrine-pause
          aria-pressed="false"
          aria-label="Pause the showcase"
          class="vitrine-pause strip-nav absolute right-[20px] top-[16px] z-10 flex h-[34px] w-[34px] items-center justify-center rounded-full text-[var(--paper)] md:right-[40px]"
        >
          <svg width="12" height="12" viewBox="0 0 12 12" fill="currentColor" aria-hidden="true" class="pause-signe">
            <g class="signe-barres">
              <rect x="2" y="1.5" width="3" height="9" rx="1" />
              <rect x="7" y="1.5" width="3" height="9" rx="1" />
            </g>
            <path class="signe-triangle" d="M3 1.8 10.2 6 3 10.2Z" />
          </svg>
        </button>

        <div class="marquee marquee-images overflow-hidden">
          <div class="marquee-track flex w-max">
            {
              [0, 1].map((tour) => (
                <ul class="flex shrink-0 list-none gap-[10px] pr-[10px]" aria-hidden={tour === 1 ? 'true' : undefined}>
                  {vitrine.map((v, i) => (
                    <li class="shrink-0">
                      <a
                        href={`#${v.slug}`}
                        data-ouvrir={v.slug}
                        data-titre={v.title}
                        tabindex={tour === 1 ? -1 : undefined}
                        class="vitrine-lien block"
                      >
                        <Picture
                          src={v.asset!}
                          alt={v.title}
                          formats={['avif']}
                          widths={[300, 450, 600, 690, 1000]}
                          sizes="(min-width: 768px) and (max-height: 900px) 450px, (min-width: 768px) 690px, 300px"
                          quality={70}
                          loading={i < 3 && tour === 0 ? 'eager' : 'lazy'}
                          fetchpriority={i === 0 && tour === 0 ? 'high' : undefined}
                          decoding="async"
                          draggable="false"
                          pictureAttributes={{ class: 'block' }}
                          class="vitrine-image aspect-[3/2] object-cover"
                        />
                      </a>
                    </li>
                  ))}
                </ul>
              ))
            }
          </div>
        </div>
      </div>

      <div class="swiss-grid gap-y-6 border-t border-[var(--rule)]" data-reveal data-reveal-slow data-reveal-delay="140">
        <h2 class="section-label swiss-meta col-span-6 text-[var(--ink-soft)] md:col-span-2">Profile
        </h2>

        <p class="swiss-lede col-span-6 md:col-span-7">
          I'm Laurent Nyssen, a Brussels-based designer creating bold identities and digital
          experiences through creative direction, strategy, branding and UX/UI
          with AI used where it truly adds value. My background blends agency,
          freelance and leadership experience across culture, music, corporate
          and non-profit projects.
        </p>

        <ul class="swiss-meta col-span-6 space-y-2 text-left min-[901px]:col-span-3 min-[901px]:justify-self-end min-[901px]:text-right">
          <li><a href="https://www.linkedin.com/in/laurentnyssen/" class="hover:text-[var(--accent-texte)]">LinkedIn <SwissArrow /></a></li>
          <li><a href="https://github.com/lnyssen" class="hover:text-[var(--accent-texte)]">GitHub <SwissArrow /></a></li>
          <li><a href="https://open.spotify.com/user/116697393" class="hover:text-[var(--accent-texte)]">Spotify <SwissArrow /></a></li>
        </ul>
      </div>
    </section>

    <!-- Compétences : la bande occupe toute la largeur du contenu, dans le
         même bloc que son intitulé pour suivre le rythme des autres sections. -->
    <section class="swiss-shell">
      <div class="swiss-grid gap-y-4 border-t border-[var(--rule)]" data-reveal>
        <h2 class="section-label swiss-meta col-start-1 col-span-6 row-start-1 text-[var(--ink-soft)] md:col-span-2">
          Skills
        </h2>

        <div class="marquee col-start-1 col-span-6 row-start-2 overflow-x-clip overflow-y-visible md:col-span-12">
          <div class="marquee-track flex w-max">
            {
              [...skills, ...skills].map((skill) => (
                <span class="flex shrink-0 items-center">
                  <span class="whitespace-nowrap text-[clamp(1.5rem,3.4vw,2.75rem)] font-medium tracking-[-0.035em]">
                    {skill}
                  </span>
                  <!-- Le rond se dimensionne en em : il suit le corps de la
                       bande, qui varie avec la largeur de la fenêtre. -->
                  <span class="marquee-dot" aria-hidden="true"></span>
                </span>
              ))
            }
          </div>
        </div>
      </div>
    </section>

    <!-- Index des projets. Chaque ligne est un <details> : la planche s'ouvre
         au clic, donc au doigt comme à la souris, sans JavaScript. -->
    <section id="work" class="swiss-shell">
      <div class="swiss-grid gap-y-4 border-t border-[var(--rule)]" data-reveal>
        <h2 class="section-label swiss-meta col-span-6 text-[var(--ink-soft)] md:col-span-2">
          Selected work
        </h2>

        <div class="col-span-6 md:col-span-10">
          {
            rendered.map(({ project, slug, Body }, i) => (
              <details name="work" id={slug} class="group border-b border-[var(--rule)] last:border-b-0" data-slug={slug} data-reveal>
                <!-- Grille explicite : le repli en flex désalignait tout sur
                     mobile. Colonne 1 le numéro, colonne 2 le titre et les
                     tags calés dessous, l'étiquette toujours à droite. -->
                <summary class="grid grid-cols-[minmax(0,1fr)_auto] items-center gap-x-4 gap-y-[9px] py-[26px] hover:text-[var(--accent-texte)] sm:grid-cols-[minmax(0,1fr)_minmax(0,1fr)_auto]">
                  <h3 class="swiss-row-title col-start-1 row-start-1">{project.data.title}</h3>

                  <span class="swiss-meta col-start-1 col-end-2 row-start-2 text-[var(--ink-soft)] sm:col-start-2 sm:col-end-3 sm:row-start-1">
                    {project.data.tags.join(', ')}
                  </span>

                  <!-- Un signe plutôt qu'un verbe : le pointeur dit déjà VIEW
                       et CLOSE au survol, mais au doigt il n'y a pas de
                       pointeur — le repère doit donc rester. -->
                  <span
                    class="col-start-2 row-start-1 row-span-2 flex h-[16px] w-[16px] items-center justify-center justify-self-end self-center text-[var(--ink-soft)] group-open:text-[var(--accent-texte)] sm:col-start-3 sm:row-span-1"
                    aria-hidden="true"
                  >
                    <svg width="14" height="14" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="1.4">
                      <path d="M0 7h14" />
                      <path d="M7 0v14" class="origin-center transition-transform duration-300 ease-out group-open:rotate-90 group-open:opacity-0" />
                    </svg>
                  </span>
                </summary>

                <!-- Quatre points de marge en haut : le contenu de la ligne
                     est rogné à ras bord le temps de l'ouverture, et le
                     contour du bouton y laissait son filet supérieur. -->
                <div class="pt-[4px] pb-[22px]">
                  <!-- L'adresse suit le texte dans sa colonne. Sous les
                       visuels, elle n'était trouvée que par ceux qui poussaient
                       la planche jusqu'au bout ; rangée dans la colonne de
                       droite, elle flottait seule dans un pan vide. Ici elle
                       tombe là où l'œil arrive en finissant de lire, et
                       téléphone comme grand écran la placent au même endroit.
                       Les visuels restent en dessous, donc vus avant qu'on
                       parte. -->
                  <div class="swiss-grid mb-[22px] gap-y-[20px]">
                    {Body && (
                      <div class="project-body col-span-6 text-[16px] leading-[1.55] text-[var(--ink-soft)] md:col-span-7 md:text-[17px]">
                        <Body />
                      </div>
                    )}

                    {project.data.link && (
                      <div class="col-span-6 md:col-span-7">
                        <a
                          href={project.data.link}
                          target="_blank"
                          rel="noopener noreferrer"
                          data-cursor-mirror={domainLabel(project.data.link)}
                          data-cursor-ink="var(--ink)"
                          class="inline-flex items-center gap-[10px] rounded-full border border-[var(--ink)] px-[24px] py-[11px] text-[15px] font-medium tracking-[-0.01em] text-[var(--ink)] bouton-accent hover:bg-[var(--ink)] hover:text-[var(--paper)]"
                        >
                          {domainLabel(project.data.link)}
                          <SwissArrow size={16} />
                        </a>
                      </div>
                    )}
                  </div>

                  <SwissFilmstrip images={project.data.images} title={project.data.title} zoom />
                </div>
              </details>
            ))
          }
        </div>
      </div>
    </section>

    <!-- Une phrase, seule, entre le travail et le reste : la manière de
         travailler, dite une fois, en grand. Pas d'intitulé — elle n'en a pas
         besoin, et un repère de section la ferait passer pour une rubrique. -->
    <section class="swiss-shell section-manifeste">
      <div class="border-t border-[var(--rule)]" data-reveal data-reveal-slow>
        <p class="manifeste">
          Design as a dialogue. Bridging forms with ideas, brands with people.
          <span class="manifeste-suite">Driven by curiosity and listening<span class="titre-point">.</span></span>
        </p>
      </div>
    </section>

    <!-- And also : même grammaire tabulaire, en plus petit. -->
    <section class="swiss-shell">
      <div class="swiss-grid gap-y-4 border-t border-[var(--rule)]" data-reveal>
        <h2 class="section-label swiss-meta col-span-6 text-[var(--ink-soft)] md:col-span-2">And also
        </h2>

        <ul class="also-list col-span-6 md:col-span-10">
          {
            also.map((item) => (
              <li class="border-b border-[var(--rule)] last:border-b-0" data-reveal>
                <a
                  href={item.link}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="grid grid-cols-[minmax(0,1fr)_auto] items-center gap-x-4 gap-y-[9px] py-[22px] hover:text-[var(--accent-texte)] sm:grid-cols-[minmax(0,1fr)_minmax(0,1fr)_auto]"
                >
                  <h3 class="also-title col-start-1 row-start-1 text-[clamp(1.125rem,1.8vw,1.5rem)] font-medium tracking-[-0.025em]">
                    {item.title}
                  </h3>

                  <span class="swiss-meta col-start-1 col-end-2 row-start-2 text-[var(--ink-soft)] sm:col-start-2 sm:col-end-3 sm:row-start-1">
                    {item.tags.join(', ')}
                  </span>

                  <span class="col-start-2 row-start-1 row-span-2 flex items-center justify-self-end self-center text-[var(--ink-soft)] sm:col-start-3 sm:row-span-1">
                    <SwissArrow size={17} />
                  </span>
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </section>
    <!-- Les trois terrains personnels — Lab, Polographe, Notes —, en triptyque sous un même filet :
         le dessin d'abord, qui dit le sujet, puis l'intitulé et la phrase
         qui mène à la page. Sur téléphone, ils s'empilent, un filet entre
         chacun. Les trois dessins tiennent le même cadre, au point près. -->
    <section class="swiss-shell section-renvoi">
      <div class="swiss-grid gap-y-0 border-t border-[var(--rule)]" data-reveal>
        <div class="renvoi-carte col-span-6 md:col-span-2 min-[901px]:col-span-4">
          <svg
            class="teaser-mark h-[54px] w-auto shrink-0 text-[var(--accent)] sm:h-[76px]"
            viewBox="0 0 150 76"
            fill="none"
            stroke="currentColor"
            stroke-width="1"
            aria-hidden="true"
          >
            <g class="mark-formes">
              <path pathLength="100" d="M12 52C34 12 58 60 76 30" />
              <path pathLength="100" d="M72 26h8v8h-8Z" />
              <path pathLength="100" d="M76 30 98 10" />
              <path pathLength="100" d="M94.5 10a3.5 3.5 0 1 0 7 0a3.5 3.5 0 1 0-7 0" />
              <path pathLength="100" d="M140 24 120 56" />
              <path pathLength="100" d="M116.5 56a3.5 3.5 0 1 0 7 0a3.5 3.5 0 1 0-7 0" />
              <path pathLength="100" d="M76 30C98 10 120 56 140 24" />
              <path pathLength="100" d="M136 20h8v8h-8Z" />
            </g>
          </svg>
          <h2 class="section-label swiss-meta text-[var(--ink-soft)]">Lab</h2>
          <a href="/lab" class="lab-teaser-title mt-[16px] block text-[clamp(1.375rem,2.2vw,1.875rem)] font-medium leading-[1.1] tracking-[-0.035em] transition-colors duration-200 hover:text-[var(--accent-texte)] focus-visible:text-[var(--accent-texte)]">
            Experiments where AI, design and code collide <SwissArrow direction="right" size={22} />
          </a>
        </div>

        <div class="renvoi-carte renvoi-suite col-span-6 md:col-span-2 min-[901px]:col-span-4">
          <svg
            class="teaser-mark h-[54px] w-auto shrink-0 text-[var(--accent)] sm:h-[76px]"
            viewBox="0 0 150 76"
            fill="none"
            stroke="currentColor"
            stroke-width="1"
            aria-hidden="true"
          >
            <path d="M1 1v74M38 1v74M75 1v74M112 1v74M149 1v74" />
            <path d="M1 1h148M1 38h148M1 75h148" />
            <g class="mark-formes">
              <path pathLength="100" d="M1 38A37 37 0 0 1 38 1" />
              <path pathLength="100" d="M38 19.5a18.5 18.5 0 1 0 37 0a18.5 18.5 0 1 0-37 0" />
              <path pathLength="100" d="M75 1A37 37 0 0 1 112 38" />
              <path pathLength="100" d="M121.25 10.25h18.5v18.5h-18.5Z" />
              <path pathLength="100" d="M1 75 19.5 38 38 75Z" />
              <path pathLength="100" d="M38 75A37 37 0 0 1 75 38" />
              <path pathLength="100" d="M75 75A18.5 18.5 0 0 1 112 75" />
              <path pathLength="100" d="M112 38A37 37 0 0 1 149 75" />
            </g>
          </svg>
          <h2 class="section-label swiss-meta text-[var(--ink-soft)]">Shapes</h2>
          <a href="/shapes" class="lab-teaser-title mt-[16px] block text-[clamp(1.375rem,2.2vw,1.875rem)] font-medium leading-[1.1] tracking-[-0.035em] transition-colors duration-200 hover:text-[var(--accent-texte)] focus-visible:text-[var(--accent-texte)]">
            A few shapes on a grid, piled up into chaos <SwissArrow direction="right" size={22} />
          </a>
        </div>

        <div class="renvoi-carte renvoi-suite col-span-6 md:col-span-2 min-[901px]:col-span-4">
          <svg
            class="teaser-mark h-[54px] w-auto shrink-0 text-[var(--accent)] sm:h-[76px]"
            viewBox="0 0 150 76"
            fill="none"
            stroke="currentColor"
            stroke-width="1"
            aria-hidden="true"
          >
            <g class="mark-formes">
              <path pathLength="100" d="M1 8h148" />
              <path pathLength="100" d="M1 26h132" />
              <path pathLength="100" d="M1 44h148" />
              <path pathLength="100" d="M1 62h86" />
              <path pathLength="100" d="M96 54v16" />
            </g>
          </svg>
          <h2 class="section-label swiss-meta text-[var(--ink-soft)]">Notes</h2>
          <a href="/notes" class="lab-teaser-title mt-[16px] block text-[clamp(1.375rem,2.2vw,1.875rem)] font-medium leading-[1.1] tracking-[-0.035em] transition-colors duration-200 hover:text-[var(--accent-texte)] focus-visible:text-[var(--accent-texte)]">
            Ideas that didn't fit <br class="hidden md:inline" />in a brief <SwissArrow direction="right" size={22} />
          </a>
        </div>
      </div>
    </section>

  </main>

  <SwissFooter />

  <script is:inline data-astro-rerun>
    // Un visuel de la vitrine ouvre sa ligne dans l'index et la ramène sous
    // la barre. Sans script, le lien descend simplement à la liste.
    //
    // La cible se calcule sur la mise en page finale, pas sur celle du
    // moment. Ouvrir une ligne referme celle qui l'était — en animation, si
    // bien que la page raccourcissait pendant le défilement et qu'on arrivait
    // trop bas. Les lignes pas encore révélées portaient aussi leur décalage
    // d'entrée. On coupe donc les animations le temps d'une image, on met la
    // page dans son état final, on mesure, puis on défile.
    (() => {
      const ouvrirProjet = (slug, doux = true) => {
        const ligne = document.querySelector(`#work details[data-slug="${CSS.escape(slug)}"]`);
        if (!ligne) return false;

        const racine = document.documentElement;
        racine.classList.add('sans-filer');

        for (const el of document.querySelectorAll('main [data-reveal]')) {
          const avant = el.compareDocumentPosition(ligne) & Node.DOCUMENT_POSITION_FOLLOWING;
          if (avant || el === ligne || el.contains(ligne)) el.classList.add('is-in');
        }
        for (const autre of document.querySelectorAll('#work details[open]')) {
          if (autre !== ligne) autre.open = false;
        }
        ligne.open = true;

        // La ligne ouverte colle sous la barre : on s'aligne sur ce même arrêt.
        // On mesure la ligne elle-même, pas son intitulé, qui une fois collant
        // donnerait sa position figée plutôt que sa place.
        const summary = ligne.querySelector(':scope > summary');
        const arret = parseFloat(getComputedStyle(summary).top) || 0;
        const y = ligne.getBoundingClientRect().top + scrollY - arret;

        requestAnimationFrame(() => {
          racine.classList.remove('sans-filer');
          scrollTo({ top: Math.max(0, y), behavior: doux ? 'smooth' : 'instant' });
        });
        return true;
      };

      // Les écouteurs du document survivent aux navigations internes : on les
      // pose une seule fois, et ils appellent la version courante.
      window.__ouvrirProjet = ouvrirProjet;
      if (!window.__ouvrirInstalle) {
        window.__ouvrirInstalle = true;
        document.addEventListener('click', (event) => {
          const lien = event.target.closest('[data-ouvrir]');
          if (!lien) return;
          if (window.__ouvrirProjet?.(lien.dataset.ouvrir)) event.preventDefault();
        });
        addEventListener('hashchange', () => {
          const slug = decodeURIComponent(location.hash.slice(1));
          if (slug) window.__ouvrirProjet?.(slug, true);
        });
      }

      // Une adresse de la forme laurentnyssen.be/#moires ouvre encore Moirés :
      // les liens déjà partagés continuent de marcher. Mais ouvrir une ligne
      // n'écrit plus rien dans la barre d'adresse — on lisait « #exaequo »
      // derrière le nom du site en parcourant l'index, ce qui n'apprend rien
      // à qui lit et salit ce qu'on copie.

      const depuisAdresse = (doux) => {
        const slug = decodeURIComponent(location.hash.slice(1));
        if (slug) ouvrirProjet(slug, doux);
      };
      // À l'arrivée, on attend la fonte et la mise en page pour mesurer juste.
      if (location.hash) {
        if (document.fonts?.ready) document.fonts.ready.then(() => depuisAdresse(false));
        // Les images chargées peuvent encore décaler la page : un dernier
        // recalage, sans animation, une fois tout arrivé.
        addEventListener('load', () => depuisAdresse(false), { once: true });
      }
    })();
  </script>

  <script is:inline data-astro-rerun>
    // Mode affiche — touche A. L'accueil se recompose en affiche du Polographe :
    // une grille de quatre cases sur sept, au format 9:16 d'une story, sur
    // l'aplat de la couleur du moment, sans texte. Chaque case reçoit une
    // forme du jeu — quart de cercle, cercle, demi-cercle, triangle, carré —,
    // pleine ou au trait, dans l'une de ses quatre orientations. Espace ou
    // un clic tire une autre
    // composition ; Échap ou A referme. De quoi faire une capture et la
    // publier.
    (() => {
      if (window.__modeAffiche) return;
      window.__modeAffiche = true;

      const FORMES = {
        quart: 'M0 100A100 100 0 0 1 100 0V100Z',
        cercle: 'M0 50a50 50 0 1 0 100 0a50 50 0 1 0-100 0',
        demi: 'M0 100a50 50 0 0 1 100 0Z',
        triangle: 'M0 100 50 0 100 100Z',
        carre: 'M25 25h50v50H25Z',
      };
      const noms = Object.keys(FORMES);
      const hasard = (n) => Math.floor(Math.random() * n);
      const melanger = (t) => {
        const r = [...t];
        for (let i = r.length - 1; i > 0; i--) {
          const j = hasard(i + 1);
          [r[i], r[j]] = [r[j], r[i]];
        }
        return r;
      };

      let cadre = null;
      let retour = null;

      // 28 cases, quatre sur sept : une forme par case, sans un mot.
      const CASES = 28;
      const composer = (affiche) => {
        let html = '';
        for (let i = 0; i < CASES; i++) {
          const forme = noms[hasard(noms.length)];
          const pleine = Math.random() < 0.5;
          const rot = hasard(4) * 90;
          html +=
            '<div class="affiche-case">' +
            '<svg viewBox="0 0 100 100" aria-hidden="true"><path d="' +
            FORMES[forme] +
            '" transform="rotate(' +
            rot +
            ' 50 50)" class="' +
            (pleine ? 'pleine' : 'trait') +
            '"/></svg>' +
            '</div>';
        }
        affiche.innerHTML = html;
      };

      const fermer = () => {
        if (!cadre) return;
        cadre.remove();
        cadre = null;
        document.removeEventListener('keydown', surTouche, true);
        if (retour?.isConnected) retour.focus({ preventScroll: true });
      };

      const surTouche = (event) => {
        if (!cadre) return;
        const k = event.key;
        if (k === 'Escape' || k.toLowerCase() === 'a') {
          event.preventDefault();
          event.stopPropagation();
          fermer();
        } else if (k === ' ' || k === 'Enter') {
          event.preventDefault();
          composer(cadre.querySelector('.affiche'));
        } else if (k === 'Tab') {
          event.preventDefault();
        }
      };

      const ouvrir = () => {
        if (!document.querySelector('.vitrine')) return;
        retour = document.activeElement;
        cadre = document.createElement('div');
        cadre.className = 'mode-affiche';
        cadre.setAttribute('role', 'dialog');
        cadre.setAttribute('aria-modal', 'true');
        cadre.setAttribute('aria-label', 'Poster — Space to recompose, Escape to close');
        const affiche = document.createElement('button');
        affiche.type = 'button';
        affiche.className = 'affiche';
        affiche.setAttribute('aria-label', 'Recomposer l’affiche');
        affiche.dataset.cursorAffiche = '';
        const aide = document.createElement('p');
        aide.className = 'affiche-aide swiss-meta';
        aide.textContent = 'Space — new composition · A — close';
        cadre.append(affiche, aide);
        composer(affiche);
        affiche.addEventListener('click', () => composer(affiche));
        cadre.addEventListener('click', (e) => {
          if (e.target === cadre) fermer();
        });
        document.body.append(cadre);
        affiche.focus({ preventScroll: true });
        document.addEventListener('keydown', surTouche, true);
      };

      document.addEventListener('keydown', (event) => {
        if (event.metaKey || event.ctrlKey || event.altKey || cadre) return;
        const t = event.target;
        if (t?.tagName === 'INPUT' || t?.tagName === 'TEXTAREA' || t?.isContentEditable) return;
        if (document.querySelector('[data-loupe]')) return;
        if (event.key.toLowerCase() === 'a') {
          event.preventDefault();
          ouvrir();
        }
      });
    })();
  </script>

  <script is:inline data-astro-rerun>
    // La vitrine avance seule, ralentit au survol, et se prend en main : on
    // la fait glisser au doigt ou à la souris, on la pousse au pavé tactile.
    // Relâchée, elle garde un peu d'élan puis reprend son allure. Un
    // glissement n'ouvre pas le projet sous le doigt ; un toucher, si.
    (() => {
      const bande = document.querySelector('.marquee-images');
      const piste = bande?.querySelector('.marquee-track');
      if (!piste) return;
      const calme = matchMedia('(prefers-reduced-motion: reduce)').matches;

      // Cent cinquante pixels par seconde sur grand écran, où la bande est
      // large et se traverse lentement ; sur téléphone, où l'écran est étroit,
      // cent quarante suffisent à donner la même vitesse apparente.
      const telephone = matchMedia('(max-width: 767px)');
      const allure = () => (calme ? 0 : telephone.matches ? 140 : 150);
      let decal = 0;
      let facteur = 1;
      let cible = 1;
      let elan = 0;
      let prise = null;
      let arret = false;
      let aGlisse = false;
      let dernier = 0;
      let visible = true;

      const moitie = () => piste.scrollWidth / 2 || 1;
      const poser = () => {
        const m = moitie();
        decal = ((decal % m) + m) % m;
        piste.style.transform = `translate3d(${-decal}px, 0, 0)`;
      };

      const tick = (t) => {
        const dt = Math.min(0.05, (t - (dernier || t)) / 1000);
        dernier = t;
        facteur += (cible - facteur) * (1 - Math.exp(-dt / 0.18));
        if (!prise && !arret) {
          decal += (allure() * facteur + elan) * dt;
          elan *= Math.exp(-dt / 0.35);
          if (Math.abs(elan) < 2) elan = 0;
        }
        poser();
        if (visible) requestAnimationFrame(tick);
        else dernier = 0;
      };

      new IntersectionObserver(([entree]) => {
        const avant = visible;
        visible = entree.isIntersecting;
        if (visible && !avant) requestAnimationFrame(tick);
      }).observe(bande);
      requestAnimationFrame(tick);

      bande.addEventListener('pointerenter', (e) => {
        if (e.pointerType === 'mouse' && !arret) cible = 0.2;
      });
      bande.addEventListener('pointerleave', () => {
        if (!arret) cible = clavier ? 0 : 1;
      });

      // La commande d'arrêt. Arrêtée, la bande ne repart ni au survol, ni au
      // défilement de la page : le visiteur l'a arrêtée, elle reste arrêtée.
      const bouton = document.querySelector('[data-vitrine-pause]');
      if (bouton) {
        if (calme) bouton.hidden = true;
        bouton.addEventListener('click', () => {
          arret = !arret;
          elan = 0;
          cible = arret ? 0 : clavier ? 0 : 1;
          if (arret) facteur = 0;
          bouton.setAttribute('aria-pressed', String(arret));
          bouton.setAttribute('aria-label', arret ? 'Play the showcase' : 'Pause the showcase');
        });
      }

      // Au clavier, la bande s'arrête net tant que le focus y est — un
      // contenu qui défile seul doit pouvoir s'arrêter — et elle amène
      // l'image qui a le focus sous les yeux. Le navigateur, lui, faisait
      // défiler la bande de travers pour montrer le lien, en plus de notre
      // propre défilement.
      let clavier = false;
      bande.addEventListener('focusin', (e) => {
        const li = e.target.closest('li');
        if (!li) return;
        clavier = true;
        cible = 0;
        facteur = 0;
        elan = 0;
      });

      // Pour montrer un lien qui reçoit le focus, le navigateur fait défiler
      // la bande lui-même, par-dessus notre propre décalage. On reprend ce
      // défilement à notre compte : il devient du décalage, et la bande
      // reste à zéro. L'image arrive sous les yeux, une seule fois.
      bande.addEventListener('scroll', () => {
        const x = bande.scrollLeft;
        if (!x) return;
        bande.scrollLeft = 0;
        decal += x;
        poser();
      });
      bande.addEventListener('focusout', (e) => {
        if (bande.contains(e.relatedTarget)) return;
        clavier = false;
        cible = 1;
      });

      // La bande suit la main. Le défilement de la page lui donne une
      // impulsion dans le sens du geste, qu'elle perd ensuite comme après un
      // glissement — c'est le même élan, nourri autrement. Elle ne suit rien
      // pendant une prise, au clavier, hors de l'écran, ni quand on demande
      // moins de mouvement.
      let dernierY = scrollY;
      let dernierT = performance.now();
      addEventListener(
        'scroll',
        () => {
          const t = performance.now();
          if (calme || arret || prise || clavier || !visible) {
            dernierY = scrollY;
            dernierT = t;
            return;
          }
          const dt = Math.max(16, t - dernierT);
          const vitesse = ((scrollY - dernierY) / dt) * 1000;
          dernierY = scrollY;
          dernierT = t;
          // Un huitième de la vitesse du doigt, et jamais plus de trois cent
          // cinquante pixels par seconde : au-delà, la bande part en trombe et
          // l'on ne lit plus les visuels. C'est une inclinaison, pas un
          // entraînement.
          elan = Math.max(-350, Math.min(350, elan + vitesse * 0.12));
        },
        { passive: true },
      );

      // Pavé tactile et molette horizontale : la bande suit le geste.
      bande.addEventListener(
        'wheel',
        (e) => {
          if (Math.abs(e.deltaX) <= Math.abs(e.deltaY)) return;
          e.preventDefault();
          decal += e.deltaX;
          elan = 0;
          poser();
        },
        { passive: false },
      );

      // Glisser, au doigt comme à la souris.
      bande.addEventListener('pointerdown', (e) => {
        if (e.pointerType === 'mouse' && e.button !== 0) return;
        prise = { id: e.pointerId, x: e.clientX, y: e.clientY, depart: decal, t: e.timeStamp, vx: 0, tenu: false };
        aGlisse = false;
        elan = 0;
      });
      bande.addEventListener('pointermove', (e) => {
        if (!prise || e.pointerId !== prise.id) return;
        const dx = e.clientX - prise.x;
        const dy = e.clientY - prise.y;
        if (!prise.tenu) {
          if (Math.abs(dx) < 6 || Math.abs(dx) < Math.abs(dy)) return;
          prise.tenu = true;
          aGlisse = true;
          try {
            bande.setPointerCapture(e.pointerId);
          } catch {}
        }
        const dt = Math.max(1, e.timeStamp - prise.t);
        const nouveau = prise.depart - dx;
        prise.vx = ((nouveau - decal) / dt) * 1000 * 0.6 + prise.vx * 0.4;
        prise.t = e.timeStamp;
        decal = nouveau;
        poser();
      });
      const lacher = (e) => {
        if (!prise || e.pointerId !== prise.id) return;
        if (prise.tenu) elan = Math.max(-2500, Math.min(2500, prise.vx)) - allure();
        prise = null;
      };
      bande.addEventListener('pointerup', lacher);
      bande.addEventListener('pointercancel', lacher);

      // Un glissement ne vaut pas un clic.
      bande.addEventListener(
        'click',
        (e) => {
          if (!aGlisse) return;
          e.preventDefault();
          e.stopPropagation();
          aGlisse = false;
        },
        true,
      );
    })();
  </script>

  <script is:inline data-astro-rerun>
    // La bande des compétences ralentit au survol au lieu de s'arrêter : une
    // piste qui se fige se lit comme une panne, une piste qui traîne se lit
    // comme une invitation à lire. Le CSS ne sait faire que le tout ou rien,
    // on règle donc la vitesse de lecture de son animation — elle reste la
    // sienne, et tient sans JavaScript.
    // Il vaut pour chaque bande de la page : les compétences et la vitrine.
    for (const bande of document.querySelectorAll('.marquee')) (() => {
      const piste = bande.querySelector('.marquee-track');
      if (!piste || matchMedia('(prefers-reduced-motion: reduce)').matches) return;

      const anim = piste.getAnimations?.()[0];
      if (!anim) return;

      // Le ralenti est réglé sur le temps et non sur les images : un simple
      // rattrapage par fraction s'effondre en deux images sur un écran rapide
      // — quatre-vingts millisecondes suffisaient à manger neuf dixièmes de la
      // vitesse, et cela se lisait encore comme un arrêt sec. Une demi-seconde
      // pleine, sur une courbe douce des deux bouts : le mot ralentit avant de
      // se poser, et repart de même.
      const DUREE = 520;
      const doux = (x) => (x < 0.5 ? 4 * x * x * x : 1 - Math.pow(-2 * x + 2, 3) / 2);

      let depart = 1;
      let cible = 1;
      let debut = 0;
      let tourne = false;

      const suivre = (maintenant) => {
        const avance = Math.min(1, (maintenant - debut) / DUREE);
        anim.playbackRate = depart + (cible - depart) * doux(avance);
        if (avance < 1) requestAnimationFrame(suivre);
        else tourne = false;
      };

      const viser = (v) => {
        if (cible === v) return;
        depart = anim.playbackRate;
        cible = v;
        debut = performance.now();
        if (!tourne) {
          tourne = true;
          requestAnimationFrame(suivre);
        }
      };

      // Un cinquième de l'allure : assez lent pour lire un intitulé au vol,
      // assez vivant pour qu'on voie que rien n'est cassé.
      bande.addEventListener('pointerenter', () => viser(0.2));
      bande.addEventListener('pointerleave', () => viser(1));
    })();
  </script>

  <script is:inline data-astro-rerun>
    // Un clic n'importe où dans une ligne dépliée la referme et la ramène au
    // centre. Les liens gardent la main.
    (() => {
      // Clavier : la page s'appelle Index, elle se parcourt donc au clavier.
      // ↑ ↓ d'un projet à l'autre, Entrée ouvre, Échap ferme, ← → dans la
      // planche du projet ouvert.
      const rows = [...document.querySelectorAll('#work details')];
      const summaries = rows.map((row) => row.querySelector('summary'));

      document.addEventListener('keydown', (event) => {
        if (event.metaKey || event.ctrlKey || event.altKey) return;
        const tag = event.target?.tagName;
        if (tag === 'INPUT' || tag === 'TEXTAREA' || event.target?.isContentEditable) return;

        // La loupe est au premier plan : tant qu'elle est ouverte, le clavier
        // lui appartient. Sans cela, Échap refermait la loupe et la ligne d'un
        // même coup, et l'on se retrouvait deux crans en arrière.
        if (document.querySelector('[data-loupe]')) return;

        const openRow = rows.find((row) => row.open);

        if (event.key === 'Escape' && openRow) {
          event.preventDefault();
          openRow.open = false;
          openRow.querySelector('summary')?.focus();
          return;
        }

        if (event.key === 'ArrowLeft' || event.key === 'ArrowRight') {
          if (!openRow) return;
          const strip = openRow.querySelector('.filmstrip');
          const figure = strip?.querySelector('figure');
          if (!strip || !figure) return;
          event.preventDefault();
          window.__filmstripAller?.(strip, event.key === 'ArrowRight' ? 1 : -1);
          return;
        }

        if (event.key !== 'ArrowDown' && event.key !== 'ArrowUp') return;

        const current = summaries.indexOf(document.activeElement?.closest('summary'));
        const next = current === -1
          ? 0
          : Math.min(summaries.length - 1, Math.max(0, current + (event.key === 'ArrowDown' ? 1 : -1)));

        event.preventDefault();
        summaries[next]?.focus();
        summaries[next]?.scrollIntoView({ block: 'center', behavior: 'smooth' });
      });

      // Une ligne qui s'ouvre ou se ferme ne doit pas emporter la page. Son
      // titre est collant tant qu'elle est ouverte : en se refermant il
      // retrouve sa place naturelle, très au-dessus, et la vue sautait avec
      // lui. On note où il est avant, et on rattrape l'écart au pixel après.
      // Le défilement doit être sec : `scroll-behavior: smooth` s'applique
      // aussi aux défilements programmés, et filerait sur toute la distance.
      const pin = (row) => {
        const summary = row.querySelector(':scope > summary');
        if (!summary) return;
        const before = summary.getBoundingClientRect().top;
        requestAnimationFrame(() => {
          const delta = summary.getBoundingClientRect().top - before;
          if (Math.abs(delta) > 1) scrollBy({ top: delta, behavior: 'instant' });
        });
      };


      for (const row of document.querySelectorAll('#work details')) {
        const summary = row.querySelector(':scope > summary');
        // Le clic précède la bascule : c'est le moment de relever la position.
        summary?.addEventListener('click', () => pin(row));

        const panel = row.querySelector(':scope > div');
        if (!panel) continue;

        // Cliquer dans la planche referme la ligne, sans bouger la page.
        panel.addEventListener('click', (event) => {
          if (event.target.closest('a, button, .filmstrip img')) return;
          pin(row);
          row.open = false;
        });
      }
    })();
  </script>
</SwissLayout>
