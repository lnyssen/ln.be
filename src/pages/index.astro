---
import { getCollection, render } from 'astro:content';
import SwissLayout from '../layouts/SwissLayout.astro';
import SwissHeader from '../components/SwissHeader.astro';
import SwissFooter from '../components/SwissFooter.astro';
import also from '../data/also.json';
import SwissArrow from '../components/SwissArrow.astro';
import SwissFilmstrip from '../components/SwissFilmstrip.astro';
import { Picture } from 'astro:assets';
import { resolveImage } from '../lib/images';

const projects = (await getCollection('projects')).sort(
  (a, b) => a.data.order - b.data.order
);

// Le corps markdown est optionnel : on ne rend le composant que s'il y a du
// texte, sinon la planche reste seule.
const rendered = await Promise.all(
  projects.map(async (project) => {
    const { Content, remarkPluginFrontmatter } = await render(project);
    // Un projet sans texte ne doit pas ouvrir un bloc vide.
    const hasBody = Boolean((project.body ?? '').trim());
    const slug = String(project.data.slug ?? (project as any).slug ?? project.id).replace(/\.md$/, '');
    return { project, slug, Body: hasBody ? Content : null, remarkPluginFrontmatter };
  })
);

// La bande d'images : le premier visuel de chaque projet, dans l'ordre de
// l'index. C'est ce qu'on voit en arrivant, avant même d'ouvrir une ligne.
const vitrine = rendered
  .map(({ project, slug }) => {
    const premiere = project.data.images?.[0];
    return {
      slug,
      title: project.data.title,
      asset: resolveImage(typeof premiere === 'string' ? premiere : premiere?.src),
    };
  })
  .filter((v) => v.asset !== null);

const skills = [
  'Brand Strategy',
  'Creative Direction',
  'UX/UI Design',
  'Visual Identity',
  'AI Powered Design',
  'Editorial & Print',
  'Design Systems',
];

// Ce que voient les réseaux sociaux quand on partage l'adresse.
const pageTitle = 'Laurent Nyssen — Multidisciplinary Designer';
const pageDescription =
  "I'm a Brussels-based designer creating bold identities and digital experiences through creative direction, strategy, branding and UX/UI with AI used where it truly adds value.";

// Le bouton affiche l'adresse plutôt qu'un verbe : plus court, et il dit où
// l'on va. Sans protocole, sans www, sans barre oblique finale.
function domainLabel(link: string) {
  try {
    const url = new URL(link);
    const host = url.hostname.replace(/^www\./, '');
    const path = url.pathname.replace(/\/$/, '');
    return host + path;
  } catch {
    return link;
  }
}
---

<SwissLayout title={pageTitle} description={pageDescription}>
  <SwissHeader current="index" />

  <main id="contenu" tabindex="-1">
    <!-- Titre pleine largeur, calé au filet. -->
    <section class="swiss-shell section-ouverture">
      <h1 class="swiss-display" data-reveal data-reveal-slow>
        Bold identities<br />and digital<br />experiences<span class="titre-point">.</span>
      </h1>

      <!-- Vitrine : une bande de visuels, un par projet, qui défile comme la
           bande des compétences et ralentit de même au survol. Posée juste
           sous le titre : placée sous la présentation, elle commençait à
           964 px sur un écran de 800 — on arrivait toujours sans une image.
           Un visuel mène à sa ligne, qui s'ouvre. La bande est doublée pour
           boucler sans couture ; la copie est cachée aux lecteurs d'écran. -->
      <div class="vitrine relative border-t border-[var(--rule)]" role="region" aria-label="Project preview" data-reveal data-reveal-slow data-reveal-delay="80">
        <!-- La bande avance seule : il faut pouvoir l'arrêter, et pas
             seulement en la survolant ou en y entrant au clavier. La commande
             se voit, se prend au doigt comme au clavier, et dit son état. Elle
             se retire quand le système demande moins de mouvement : la bande
             ne bouge alors pas, il n'y a rien à arrêter. -->
        <button
          type="button"
          data-vitrine-pause
          aria-pressed="false"
          aria-label="Pause the showcase"
          class="vitrine-pause strip-nav absolute right-[20px] top-[16px] z-10 flex h-[34px] w-[34px] items-center justify-center rounded-full text-[var(--paper)] md:right-[40px]"
        >
          <svg width="12" height="12" viewBox="0 0 12 12" fill="currentColor" aria-hidden="true" class="pause-signe">
            <g class="signe-barres">
              <rect x="2" y="1.5" width="3" height="9" rx="1" />
              <rect x="7" y="1.5" width="3" height="9" rx="1" />
            </g>
            <path class="signe-triangle" d="M3 1.8 10.2 6 3 10.2Z" />
          </svg>
        </button>

        <div class="marquee marquee-images overflow-hidden">
          <div class="marquee-track flex w-max">
            {
              [0, 1].map((tour) => (
                <ul class="flex shrink-0 list-none gap-[10px] pr-[10px]" aria-hidden={tour === 1 ? 'true' : undefined}>
                  {vitrine.map((v, i) => (
                    <li class="shrink-0">
                      <a
                        href={`#${v.slug}`}
                        data-ouvrir={v.slug}
                        data-titre={v.title}
                        tabindex={tour === 1 ? -1 : undefined}
                        class="vitrine-lien block"
                      >
                        <Picture
                          src={v.asset!}
                          alt={v.title}
                          formats={['avif']}
                          widths={[300, 450, 600, 690, 1000]}
                          sizes="(min-width: 768px) and (max-height: 900px) 450px, (min-width: 768px) 690px, 300px"
                          quality={70}
                          loading={i < 3 && tour === 0 ? 'eager' : 'lazy'}
                          fetchpriority={i === 0 && tour === 0 ? 'high' : undefined}
                          decoding="async"
                          draggable="false"
                          pictureAttributes={{ class: 'block' }}
                          class="vitrine-image aspect-[3/2] object-cover"
                        />
                      </a>
                    </li>
                  ))}
                </ul>
              ))
            }
          </div>
        </div>
      </div>

      <div class="swiss-grid gap-y-6 border-t border-[var(--rule)]" data-reveal data-reveal-slow data-reveal-delay="140">
        <h2 class="section-label swiss-meta col-span-6 text-[var(--ink-soft)] md:col-span-2">Profile
        </h2>

        <p class="swiss-lede col-span-6 md:col-span-7">
          I'm a Brussels-based designer creating bold identities and digital
          experiences through creative direction, strategy, branding and UX/UI
          with AI used where it truly adds value. My background blends agency,
          freelance and leadership experience across culture, music, corporate
          and non-profit projects.
        </p>

        <ul class="swiss-meta col-span-6 space-y-2 text-left min-[901px]:col-span-3 min-[901px]:justify-self-end min-[901px]:text-right">
          <li><a href="https://www.linkedin.com/in/laurentnyssen/" class="hover:text-[var(--accent-texte)]">LinkedIn <SwissArrow /></a></li>
          <li><a href="https://open.spotify.com/user/116697393?si=a871d45a9bb14fe0" class="hover:text-[var(--accent-texte)]">Spotify <SwissArrow /></a></li>
        </ul>
      </div>
    </section>

    <!-- Compétences : la bande occupe toute la largeur du contenu, dans le
         même bloc que son intitulé pour suivre le rythme des autres sections. -->
    <section class="swiss-shell">
      <div class="swiss-grid gap-y-4 border-t border-[var(--rule)]" data-reveal>
        <h2 class="section-label swiss-meta col-start-1 col-span-6 row-start-1 text-[var(--ink-soft)] md:col-span-2">
          Skills
        </h2>

        <div class="marquee col-start-1 col-span-6 row-start-2 overflow-hidden md:col-span-12">
          <div class="marquee-track flex w-max">
            {
              [...skills, ...skills].map((skill) => (
                <span class="flex shrink-0 items-center">
                  <span class="whitespace-nowrap text-[clamp(1.5rem,3.4vw,2.75rem)] font-medium tracking-[-0.035em]">
                    {skill}
                  </span>
                  <!-- Le rond se dimensionne en em : il suit le corps de la
                       bande, qui varie avec la largeur de la fenêtre. -->
                  <span class="marquee-dot" aria-hidden="true"></span>
                </span>
              ))
            }
          </div>
        </div>
      </div>
    </section>

    <!-- Index des projets. Chaque ligne est un <details> : la planche s'ouvre
         au clic, donc au doigt comme à la souris, sans JavaScript. -->
    <section id="work" class="swiss-shell">
      <div class="swiss-grid gap-y-4 border-t border-[var(--rule)]" data-reveal>
        <h2 class="section-label swiss-meta col-span-6 text-[var(--ink-soft)] md:col-span-2">
          Selected work
        </h2>

        <div class="col-span-6 md:col-span-10">
          {
            rendered.map(({ project, slug, Body }, i) => (
              <details name="work" id={slug} class="group border-b border-[var(--rule)] last:border-b-0" data-slug={slug} data-reveal>
                <!-- Grille explicite : le repli en flex désalignait tout sur
                     mobile. Colonne 1 le numéro, colonne 2 le titre et les
                     tags calés dessous, l'étiquette toujours à droite. -->
                <summary class="grid grid-cols-[minmax(0,1fr)_auto] items-center gap-x-4 gap-y-[9px] py-[26px] hover:text-[var(--accent-texte)] sm:grid-cols-[minmax(0,1fr)_minmax(0,1fr)_auto]">
                  <h3 class="swiss-row-title col-start-1 row-start-1">{project.data.title}</h3>

                  <span class="swiss-meta col-start-1 col-end-2 row-start-2 text-[var(--ink-soft)] sm:col-start-2 sm:col-end-3 sm:row-start-1">
                    {project.data.tags.join(', ')}
                  </span>

                  <!-- Un signe plutôt qu'un verbe : le pointeur dit déjà VIEW
                       et CLOSE au survol, mais au doigt il n'y a pas de
                       pointeur — le repère doit donc rester. -->
                  <span
                    class="col-start-2 row-start-1 row-span-2 flex h-[16px] w-[16px] items-center justify-center justify-self-end self-center text-[var(--ink-soft)] group-open:text-[var(--accent-texte)] sm:col-start-3 sm:row-span-1"
                    aria-hidden="true"
                  >
                    <svg width="14" height="14" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="1.4">
                      <path d="M0 7h14" />
                      <path d="M7 0v14" class="origin-center transition-transform duration-300 ease-out group-open:rotate-90 group-open:opacity-0" />
                    </svg>
                  </span>
                </summary>

                <!-- Quatre points de marge en haut : le contenu de la ligne
                     est rogné à ras bord le temps de l'ouverture, et le
                     contour du bouton y laissait son filet supérieur. -->
                <div class="pt-[4px] pb-[22px]">
                  <!-- L'adresse suit le texte dans sa colonne. Sous les
                       visuels, elle n'était trouvée que par ceux qui poussaient
                       la planche jusqu'au bout ; rangée dans la colonne de
                       droite, elle flottait seule dans un pan vide. Ici elle
                       tombe là où l'œil arrive en finissant de lire, et
                       téléphone comme grand écran la placent au même endroit.
                       Les visuels restent en dessous, donc vus avant qu'on
                       parte. -->
                  <div class="swiss-grid mb-[22px] gap-y-[20px]">
                    {Body && (
                      <div class="project-body col-span-6 text-[16px] leading-[1.55] text-[var(--ink-soft)] md:col-span-7 md:text-[17px]">
                        <Body />
                      </div>
                    )}

                    {project.data.link && (
                      <div class="col-span-6 md:col-span-7">
                        <a
                          href={project.data.link}
                          target="_blank"
                          rel="noopener noreferrer"
                          data-cursor-mirror={domainLabel(project.data.link)}
                          data-cursor-ink="var(--accent)"
                          class="inline-flex items-center gap-[10px] rounded-full border border-[var(--ink)] px-[24px] py-[11px] text-[15px] font-medium tracking-[-0.01em] text-[var(--ink)] bouton-accent hover:bg-[var(--ink)] hover:text-[var(--paper)]"
                        >
                          {domainLabel(project.data.link)}
                          <SwissArrow size={16} />
                        </a>
                      </div>
                    )}
                  </div>

                  <SwissFilmstrip images={project.data.images} title={project.data.title} zoom />
                </div>
              </details>
            ))
          }
        </div>
      </div>
    </section>

    <!-- And also : même grammaire tabulaire, en plus petit. -->
    <section class="swiss-shell">
      <div class="swiss-grid gap-y-4 border-t border-[var(--rule)]" data-reveal>
        <h2 class="section-label swiss-meta col-span-6 text-[var(--ink-soft)] md:col-span-2">And also
        </h2>

        <ul class="also-list col-span-6 md:col-span-10">
          {
            also.map((item) => (
              <li class="border-b border-[var(--rule)] last:border-b-0" data-reveal>
                <a
                  href={item.link}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="grid grid-cols-[minmax(0,1fr)_auto] items-center gap-x-4 gap-y-[9px] py-[22px] hover:text-[var(--accent-texte)] sm:grid-cols-[minmax(0,1fr)_minmax(0,1fr)_auto]"
                >
                  <h3 class="also-title col-start-1 row-start-1 text-[clamp(1.125rem,1.8vw,1.5rem)] font-medium tracking-[-0.025em]">
                    {item.title}
                  </h3>

                  <span class="swiss-meta col-start-1 col-end-2 row-start-2 text-[var(--ink-soft)] sm:col-start-2 sm:col-end-3 sm:row-start-1">
                    {item.tags.join(', ')}
                  </span>

                  <span class="col-start-2 row-start-1 row-span-2 flex items-center justify-self-end self-center text-[var(--ink-soft)] sm:col-start-3 sm:row-span-1">
                    <SwissArrow size={17} />
                  </span>
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </section>
    <!-- Les deux terrains personnels, l'un sous l'autre. Côte à côte, l'un
         tenait sur une ligne et l'autre sur deux : la paire boitait. Chacun
         prend donc toute la largeur et suit le rythme des autres sections —
         aucune marge propre, sans quoi il respirerait plus large que le
         reste. À sa droite, un dessin au trait qui dit son sujet. -->
    <section class="swiss-shell section-renvoi">
      <div class="swiss-grid border-t border-[var(--rule)]" data-reveal>
        <!-- L'intitulé nomme la section, il n'est pas le lien : seule la
             phrase en dessous répond au pointeur. -->
        <div class="teaser col-span-6 flex items-center justify-between gap-5 md:col-span-12">
          <span class="block min-w-0">
            <h2 class="section-label swiss-meta text-[var(--ink-soft)]">Creative lab</h2>
            <a href="/lab" class="lab-teaser-title mt-[16px] block text-[clamp(1.375rem,2.6vw,2rem)] font-medium leading-[1.1] tracking-[-0.035em] transition-colors duration-200 hover:text-[var(--accent-texte)] focus-visible:text-[var(--accent-texte)]">
              Experiments where AI, design and code collide <SwissArrow direction="right" size={24} />
            </a>
          </span>

          <!-- Une courbe tracée à la main, puis continuée par la machine.
               À gauche, une Bézier nue : le geste, rien d'autre. À droite, la
               suite du même trait — mais cette fois son appareillage est
               visible, ancres carrées, tangentes et points de contrôle. C'est
               ce que fait une machine à qui l'on donne un début : elle
               poursuit, et elle montre ses coordonnées là où la main ne
               montrait qu'un mouvement. Le dessin se trace dans cet ordre —
               la main d'abord, l'appareil ensuite, la prédiction en dernier.
               Même cadre que le Polographe au point près, pour que les deux
               renvois pèsent pareil. -->
          <svg
            class="teaser-mark h-[54px] w-auto shrink-0 text-[var(--accent)] sm:h-[76px]"
            viewBox="0 0 150 76"
            fill="none"
            stroke="currentColor"
            stroke-width="1"
            aria-hidden="true"
          >
            <g class="mark-formes">
              <path pathLength="100" d="M12 52C34 12 58 60 76 30" />
              <path pathLength="100" d="M72 26h8v8h-8Z" />
              <path pathLength="100" d="M76 30 98 10" />
              <path pathLength="100" d="M94.5 10a3.5 3.5 0 1 0 7 0a3.5 3.5 0 1 0-7 0" />
              <path pathLength="100" d="M140 24 120 56" />
              <path pathLength="100" d="M116.5 56a3.5 3.5 0 1 0 7 0a3.5 3.5 0 1 0-7 0" />
              <path pathLength="100" d="M76 30C98 10 120 56 140 24" />
              <path pathLength="100" d="M136 20h8v8h-8Z" />
            </g>
          </svg>
        </div>
      </div>
    </section>

    <section class="swiss-shell section-renvoi">
      <div class="swiss-grid border-t border-[var(--rule)]" data-reveal>
        <!-- L'intitulé nomme la section, il n'est pas le lien : seule la
             phrase en dessous répond au pointeur. -->
        <div class="teaser col-span-6 flex items-center justify-between gap-5 md:col-span-12">
          <span class="block min-w-0">
            <h2 class="section-label swiss-meta text-[var(--ink-soft)]">Le Polographe</h2>
            <a href="/lepolographe" class="lab-teaser-title mt-[16px] block text-[clamp(1.375rem,2.6vw,2rem)] font-medium leading-[1.1] tracking-[-0.035em] transition-colors duration-200 hover:text-[var(--accent-texte)] focus-visible:text-[var(--accent-texte)]">
              A few shapes on a grid, piled up into chaos <SwissArrow direction="right" size={24} />
            </a>
          </span>

          <!-- Huit cases, huit formes : quarts de cercle, cercle, demi-cercle
               triangle et carré, tous tirés du même petit jeu, seule
               l'orientation change. C'est la règle des affiches. Les carrés sont posés au
               centre de leur case plutôt que sur ses bords, sans quoi ils se
               confondraient avec la grille. Même cadre que le dessin du Lab,
               au point près, pour que les deux renvois pèsent pareil. -->
          <svg
            class="teaser-mark h-[54px] w-auto shrink-0 text-[var(--accent)] sm:h-[76px]"
            viewBox="0 0 150 76"
            fill="none"
            stroke="currentColor"
            stroke-width="1"
            aria-hidden="true"
          >
            <path d="M1 1v74M38 1v74M75 1v74M112 1v74M149 1v74" />
            <path d="M1 1h148M1 38h148M1 75h148" />
            <g class="mark-formes">
              <path pathLength="100" d="M1 38A37 37 0 0 1 38 1" />
              <path pathLength="100" d="M38 19.5a18.5 18.5 0 1 0 37 0a18.5 18.5 0 1 0-37 0" />
              <path pathLength="100" d="M75 1A37 37 0 0 1 112 38" />
              <path pathLength="100" d="M121.25 10.25h18.5v18.5h-18.5Z" />
              <path pathLength="100" d="M1 75 19.5 38 38 75Z" />
              <path pathLength="100" d="M38 75A37 37 0 0 1 75 38" />
              <path pathLength="100" d="M75 75A18.5 18.5 0 0 1 112 75" />
              <path pathLength="100" d="M112 38A37 37 0 0 1 149 75" />
            </g>
          </svg>
        </div>
      </div>
    </section>

  </main>

  <SwissFooter />

  <script is:inline data-astro-rerun>
    // Un visuel de la vitrine ouvre sa ligne dans l'index et la ramène sous
    // la barre. Sans script, le lien descend simplement à la liste.
    //
    // La cible se calcule sur la mise en page finale, pas sur celle du
    // moment. Ouvrir une ligne referme celle qui l'était — en animation, si
    // bien que la page raccourcissait pendant le défilement et qu'on arrivait
    // trop bas. Les lignes pas encore révélées portaient aussi leur décalage
    // d'entrée. On coupe donc les animations le temps d'une image, on met la
    // page dans son état final, on mesure, puis on défile.
    (() => {
      const ouvrirProjet = (slug, doux = true) => {
        const ligne = document.querySelector(`#work details[data-slug="${CSS.escape(slug)}"]`);
        if (!ligne) return false;

        const racine = document.documentElement;
        racine.classList.add('sans-filer');

        for (const el of document.querySelectorAll('main [data-reveal]')) {
          const avant = el.compareDocumentPosition(ligne) & Node.DOCUMENT_POSITION_FOLLOWING;
          if (avant || el === ligne || el.contains(ligne)) el.classList.add('is-in');
        }
        for (const autre of document.querySelectorAll('#work details[open]')) {
          if (autre !== ligne) autre.open = false;
        }
        ligne.open = true;

        // La ligne ouverte colle sous la barre : on s'aligne sur ce même arrêt.
        // On mesure la ligne elle-même, pas son intitulé, qui une fois collant
        // donnerait sa position figée plutôt que sa place.
        const summary = ligne.querySelector(':scope > summary');
        const arret = parseFloat(getComputedStyle(summary).top) || 0;
        const y = ligne.getBoundingClientRect().top + scrollY - arret;

        requestAnimationFrame(() => {
          racine.classList.remove('sans-filer');
          scrollTo({ top: Math.max(0, y), behavior: doux ? 'smooth' : 'instant' });
        });
        return true;
      };

      // Les écouteurs du document survivent aux navigations internes : on les
      // pose une seule fois, et ils appellent la version courante.
      window.__ouvrirProjet = ouvrirProjet;
      if (!window.__ouvrirInstalle) {
        window.__ouvrirInstalle = true;
        document.addEventListener('click', (event) => {
          const lien = event.target.closest('[data-ouvrir]');
          if (!lien) return;
          if (window.__ouvrirProjet?.(lien.dataset.ouvrir)) event.preventDefault();
        });
        addEventListener('hashchange', () => {
          const slug = decodeURIComponent(location.hash.slice(1));
          if (slug) window.__ouvrirProjet?.(slug, true);
        });
      }

      // Une adresse de la forme laurentnyssen.be/#moires ouvre encore Moirés :
      // les liens déjà partagés continuent de marcher. Mais ouvrir une ligne
      // n'écrit plus rien dans la barre d'adresse — on lisait « #exaequo »
      // derrière le nom du site en parcourant l'index, ce qui n'apprend rien
      // à qui lit et salit ce qu'on copie.

      const depuisAdresse = (doux) => {
        const slug = decodeURIComponent(location.hash.slice(1));
        if (slug) ouvrirProjet(slug, doux);
      };
      // À l'arrivée, on attend la fonte et la mise en page pour mesurer juste.
      if (location.hash) {
        if (document.fonts?.ready) document.fonts.ready.then(() => depuisAdresse(false));
        // Les images chargées peuvent encore décaler la page : un dernier
        // recalage, sans animation, une fois tout arrivé.
        addEventListener('load', () => depuisAdresse(false), { once: true });
      }
    })();
  </script>

  <script is:inline data-astro-rerun>
    // Mode affiche — touche A. L'accueil se recompose en affiche du Polographe :
    // une grille de quatre cases sur sept, au format 9:16 d'une story, sur
    // l'aplat de la couleur du moment, sans texte. Chaque case reçoit une
    // forme du jeu — quart de cercle, cercle, demi-cercle, triangle, carré —,
    // pleine ou au trait, dans l'une de ses quatre orientations. Espace ou
    // un clic tire une autre
    // composition ; Échap ou A referme. De quoi faire une capture et la
    // publier.
    (() => {
      if (window.__modeAffiche) return;
      window.__modeAffiche = true;

      const FORMES = {
        quart: 'M0 100A100 100 0 0 1 100 0V100Z',
        cercle: 'M0 50a50 50 0 1 0 100 0a50 50 0 1 0-100 0',
        demi: 'M0 100a50 50 0 0 1 100 0Z',
        triangle: 'M0 100 50 0 100 100Z',
        carre: 'M25 25h50v50H25Z',
      };
      const noms = Object.keys(FORMES);
      const hasard = (n) => Math.floor(Math.random() * n);
      const melanger = (t) => {
        const r = [...t];
        for (let i = r.length - 1; i > 0; i--) {
