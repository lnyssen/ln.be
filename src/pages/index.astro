        // jusqu'au bout au lieu de s'arrêter net, et le même passage sert au
        // doigt, aux flèches, au clavier et à la molette — d'où qu'on vienne,
        // on voit la même chose.
        let enVol = false;
        const glisser = (px) => scene.style.setProperty('--glisse', `${px}px`);
        const voiler = (v) => scene.style.setProperty('--voile', v);

        const filer = (sens) => {
          if (enVol) return;
          enVol = true;
          const ecart = Math.min(scene.getBoundingClientRect().width * 0.22, 180);
          grand.classList.remove('sans-transition');
          grand.classList.add('file');
          glisser(-sens * ecart);
          voiler(0);
          // La sortie et le chargement courent ensemble ; l'entrée attend les
          // deux. Une image pas encore prête ne s'affiche jamais à moitié.
          const suivant = (rang + sens + visuels.length) % visuels.length;
          const sortie = new Promise((fin) => setTimeout(fin, 170));
          Promise.all([charger(suivant), sortie]).then(([tirage]) => {
            rang = suivant;
            montrer(tirage, visuels[suivant]);
            charger(suivant + 1);
            charger(suivant - 1);
            grand.classList.add('sans-transition');
            grand.classList.remove('file');
            glisser(sens * ecart);
            // Deux images d'attente : la première pose la position sans
            // transition, la seconde la relâche. En une seule, le navigateur
            // regroupe les deux écritures et rien ne glisse.
            requestAnimationFrame(() => {
              requestAnimationFrame(() => {
                grand.classList.remove('sans-transition');
                glisser(0);
                voiler(1);
                enVol = false;
              });
            });
          });
        };

        grand.addEventListener('load', caler);

        // À l'ouverture, la vignette déjà chargée s'affiche aussitôt, pour que
        // le geste réponde ; l'agrandi la remplace dès qu'il est décodé — une
        // mise au point, sans saut de cadrage.
        grand.src = img.currentSrc || img.src;
        grand.alt = img.alt;
        poser(rang);
        scene.append(grand);
        cadre.append(scene);

        // Les flèches ne paraissent qu'à partir de deux visuels, et portent la
        // matière de celles de la planche. Elles arrêtent le clic : lui, il
        // referme.
        if (visuels.length > 1) {
          for (const sens of [-1, 1]) {
            const bouton = document.createElement('button');
            bouton.type = 'button';
            bouton.className = `strip-nav loupe-nav loupe-nav-${sens < 0 ? 'prev' : 'next'}`;
            bouton.dataset.loupeNav = '';
            bouton.dataset.cursorMirror = '';
            bouton.dataset.cursorInk = 'var(--accent)';
            bouton.setAttribute('aria-label', sens < 0 ? 'Previous image' : 'Next image');
            bouton.innerHTML =
              '<svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">' +
              (sens < 0 ? '<path d="M15 5l-7 7 7 7"/>' : '<path d="M9 5l7 7-7 7"/>') +
              '</svg>';
            bouton.addEventListener('click', (event) => {
              event.stopPropagation();
              filer(sens);
            });
            scene.append(bouton);
          }
        }

        // Le visuel se feuillette aussi à la main : un glissement horizontal au
        // doigt, ou deux doigts sur le pavé tactile. L'image suit le geste —
        // sans lui, on ne sait pas si le glissement est pris — puis passe au
        // suivant si le geste est franc, et revient si on se ravise.
        let aGlisse = false;

        let roulis = 0;
        let repos = null;
        const surRoulette = (event) => {
          // Le glissement vertical appartient encore à la page : on ne prend
          // que ce qui est franchement horizontal.
          if (Math.abs(event.deltaX) <= Math.abs(event.deltaY)) return;
          event.preventDefault();
          clearTimeout(repos);
          repos = setTimeout(() => {
            roulis = 0;
          }, 220);
          if (Math.abs(roulis) > 90) return;
          roulis += event.deltaX;
          if (Math.abs(roulis) > 90) {
            filer(roulis > 0 ? 1 : -1);
            aGlisse = true;
            setTimeout(() => {
              aGlisse = false;
            }, 0);
          }
        };

        if (visuels.length > 1) {
          let depart = null;
          let tenu = false;

          scene.addEventListener('pointerdown', (event) => {
            if (event.button !== 0 || event.target.closest('[data-loupe-nav]')) return;
            depart = { x: event.clientX, y: event.clientY, id: event.pointerId };
            tenu = false;
            aGlisse = false;
          });

          scene.addEventListener('pointermove', (event) => {
            if (!depart || event.pointerId !== depart.id) return;
            const dx = event.clientX - depart.x;
            const dy = event.clientY - depart.y;
            if (!tenu) {
              // Tant que la direction n'est pas tranchée, on ne prend rien.
              if (Math.abs(dx) < 8 || Math.abs(dx) <= Math.abs(dy)) return;
              tenu = true;
              grand.classList.add('sans-transition');
              // La capture n'est qu'un confort : si le pointeur a déjà quitté
              // la scène, le geste continue quand même.
              try {
                scene.setPointerCapture(event.pointerId);
              } catch {}
            }
            // Le visuel suit le doigt d'un peu moins loin : il indique le
            // geste sans promettre qu'il se décollera.
            glisser(dx * 0.7);
          });

          const fin = (event) => {
            if (!depart || event.pointerId !== depart.id) return;
            const dx = event.clientX - depart.x;
            depart = null;
            if (!tenu) return;
            tenu = false;
            aGlisse = true;
            if (Math.abs(dx) > 56) {
              filer(dx < 0 ? 1 : -1);
            } else {
              // On s'est ravisé : le visuel revient à sa place.
              grand.classList.remove('sans-transition');
              glisser(0);
            }
          };

          scene.addEventListener('pointerup', fin);
          scene.addEventListener('pointercancel', fin);
          cadre.addEventListener('wheel', surRoulette, { passive: false });
        }

        document.body.append(cadre);
        cadre.focus({ preventScroll: true });
        requestAnimationFrame(() => {
          cadre.classList.add('is-open');
          caler();
          relireLeCurseur();
        });
        addEventListener('resize', caler);

        const fermer = () => {
          cadre.classList.remove('is-open');
          cadre.addEventListener(
            'transitionend',
            () => {
              cadre.remove();
              relireLeCurseur();
            },
            { once: true },
          );
          document.removeEventListener('keydown', surTouche);
          if (retour?.isConnected) retour.focus({ preventScroll: true });
          removeEventListener('resize', caler);
          cadre.removeEventListener('wheel', surRoulette);
          clearTimeout(repos);
        };

        const surTouche = (event) => {
          // Tab tourne entre les commandes de la loupe, sans en sortir.
          if (event.key === 'Tab') {
            const commandes = [cadre, ...cadre.querySelectorAll('button')];
            const i = commandes.indexOf(document.activeElement);
            const j = (i + (event.shiftKey ? -1 : 1) + commandes.length) % commandes.length;
            commandes[j].focus();
            event.preventDefault();
            return;
          }
          if (event.key === 'Escape') fermer();
          else if (event.key === 'ArrowLeft') filer(-1);
          else if (event.key === 'ArrowRight') filer(1);
          else return;
          event.preventDefault();
        };

        // Un glissement n'est pas un clic : il ne referme pas.
        cadre.addEventListener('click', () => {
          if (aGlisse) {
            aGlisse = false;
            return;
          }
          fermer();
        });
        document.addEventListener('keydown', surTouche);
      };

      document.addEventListener('click', (event) => {
        const img = event.target.closest('.filmstrip img');
        if (img) loupe(img);
      });

      // Entrée ou espace sur une vignette : elle s'agrandit, comme au clic.
      document.addEventListener('keydown', (event) => {
        if (event.key !== 'Enter' && event.key !== ' ') return;
        const img = event.target.closest?.('.filmstrip img');
        if (!img) return;
        event.preventDefault();
        loupe(img);
      });

      for (const row of document.querySelectorAll('#work details')) {
        const summary = row.querySelector(':scope > summary');
        // Le clic précède la bascule : c'est le moment de relever la position.
        summary?.addEventListener('click', () => pin(row));

        const panel = row.querySelector(':scope > div');
        if (!panel) continue;

        // Cliquer dans la planche referme la ligne, sans bouger la page.
        panel.addEventListener('click', (event) => {
          if (event.target.closest('a, button, .filmstrip img')) return;
          pin(row);
          row.open = false;
        });
      }
    })();
  </script>
</SwissLayout>
