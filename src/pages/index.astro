        if (!document.querySelector('.vitrine')) return;
        retour = document.activeElement;
        cadre = document.createElement('div');
        cadre.className = 'mode-affiche';
        cadre.setAttribute('role', 'dialog');
        cadre.setAttribute('aria-modal', 'true');
        cadre.setAttribute('aria-label', 'Poster — Space to recompose, Escape to close');
        const affiche = document.createElement('button');
        affiche.type = 'button';
        affiche.className = 'affiche';
        affiche.setAttribute('aria-label', 'Recomposer l’affiche');
        affiche.dataset.cursorAffiche = '';
        const aide = document.createElement('p');
        aide.className = 'affiche-aide swiss-meta';
        aide.textContent = 'Space — new composition · A — close';
        cadre.append(affiche, aide);
