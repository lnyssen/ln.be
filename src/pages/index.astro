            '<div class="affiche-case">' +
            '<svg viewBox="0 0 100 100" aria-hidden="true"><path d="' +
            FORMES[forme] +
            '" transform="rotate(' +
            rot +
            ' 50 50)" class="' +
            (pleine ? 'pleine' : 'trait') +
            '"/></svg>' +
            '</div>';
