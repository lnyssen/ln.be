---
import { getCollection, render } from 'astro:content';
import SwissLayout from '../layouts/SwissLayout.astro';
import SwissHeader from '../components/SwissHeader.astro';
import SwissFooter from '../components/SwissFooter.astro';
import also from '../data/also.json';
import SwissArrow from '../components/SwissArrow.astro';
import SwissFilmstrip from '../components/SwissFilmstrip.astro';

const projects = (await getCollection('projects')).sort(
  (a, b) => a.data.order - b.data.order
);

// Le corps markdown est optionnel : on ne rend le composant que s'il y a du
// texte, sinon la planche reste seule.
const rendered = await Promise.all(
  projects.map(async (project) => {
    const { Content, remarkPluginFrontmatter } = await render(project);
    // Un projet sans texte ne doit pas ouvrir un bloc vide.
    const hasBody = Boolean((project.body ?? '').trim());
    const slug = String(project.data.slug ?? (project as any).slug ?? project.id).replace(/\.md$/, '');
    return { project, slug, Body: hasBody ? Content : null, remarkPluginFrontmatter };
  })
);

const skills = [
  'Brand Strategy',
  'Creative Direction',
  'UX/UI Design',
  'Visual Identity',
  'AI Powered Design',
  'Editorial & Print',
  'Design Systems',
];

// Ce que voient les réseaux sociaux quand on partage l'adresse.
const pageTitle = 'Laurent Nyssen — Multidisciplinary Designer';
const pageDescription =
  "I'm a Brussels-based designer creating bold identities and digital experiences through creative direction, strategy, branding and UX/UI with AI used where it truly adds value.";

// Le bouton affiche l'adresse plutôt qu'un verbe : plus court, et il dit où
// l'on va. Sans protocole, sans www, sans barre oblique finale.
function domainLabel(link: string) {
  try {
    const url = new URL(link);
    const host = url.hostname.replace(/^www\./, '');
    const path = url.pathname.replace(/\/$/, '');
    return host + path;
  } catch {
    return link;
  }
}
---

<SwissLayout title={pageTitle} description={pageDescription}>
  <SwissHeader current="index" />

  <main id="contenu" tabindex="-1">
    <!-- Titre pleine largeur, calé au filet. -->
    <section class="swiss-shell pt-[40px] md:pt-[72px]">
      <h1 class="swiss-display" data-reveal data-reveal-slow>
        Bold identities<br />and digital<br />experiences<button
          type="button"
          data-accent-cycle
          aria-label="Changer la couleur d'accent du site"
          title="Changer la couleur d'accent"
        >.</button>
      </h1>

      <div class="swiss-grid mt-[40px] gap-y-6 border-t border-[var(--rule)]" data-reveal data-reveal-slow data-reveal-delay="140">
        <h2 class="section-label swiss-meta col-span-6 text-[var(--ink-soft)] md:col-span-2">Profile
        </h2>

        <p class="swiss-lede col-span-6 md:col-span-7">
          I'm a Brussels-based designer creating bold identities and digital
          experiences through creative direction, strategy, branding and UX/UI
          with AI used where it truly adds value. My background blends agency,
          freelance and leadership experience across culture, music, corporate
          and non-profit projects.
        </p>

        <ul class="swiss-meta col-span-6 space-y-2 text-left min-[901px]:col-span-3 min-[901px]:justify-self-end min-[901px]:text-right">
          <li><a href="https://www.linkedin.com/in/laurentnyssen/" class="hover:text-[var(--accent)]">LinkedIn <SwissArrow /></a></li>
          <li><a href="https://open.spotify.com/user/116697393?si=a871d45a9bb14fe0" class="hover:text-[var(--accent)]">Spotify <SwissArrow /></a></li>
        </ul>
      </div>
    </section>

    <!-- Compétences : la bande occupe toute la largeur du contenu, dans le
         même bloc que son intitulé pour suivre le rythme des autres sections. -->
    <section class="swiss-shell">
      <div class="swiss-grid gap-y-4 border-t border-[var(--rule)]" data-reveal>
        <h2 class="section-label swiss-meta col-start-1 col-span-6 row-start-1 text-[var(--ink-soft)] md:col-span-2">
          Skills
        </h2>

        <div class="marquee col-start-1 col-span-6 row-start-2 overflow-hidden md:col-span-12">
          <div class="marquee-track flex w-max">
            {
              [...skills, ...skills].map((skill) => (
                <span class="flex shrink-0 items-center">
                  <span class="whitespace-nowrap text-[clamp(1.5rem,3.4vw,2.75rem)] font-medium tracking-[-0.035em]">
                    {skill}
                  </span>
                  <!-- Le rond se dimensionne en em : il suit le corps de la
                       bande, qui varie avec la largeur de la fenêtre. -->
                  <span class="marquee-dot" aria-hidden="true"></span>
                </span>
              ))
            }
          </div>
        </div>
      </div>
    </section>

    <!-- Index des projets. Chaque ligne est un <details> : la planche s'ouvre
         au clic, donc au doigt comme à la souris, sans JavaScript. -->
    <section id="work" class="swiss-shell">
      <div class="swiss-grid gap-y-4 border-t border-[var(--rule)]" data-reveal>
        <h2 class="section-label swiss-meta col-span-6 text-[var(--ink-soft)] md:col-span-2">
          Selected work
        </h2>

        <div class="col-span-6 md:col-span-10">
          {
            rendered.map(({ project, slug, Body }, i) => (
              <details name="work" class="group border-b border-[var(--rule)] last:border-b-0" data-slug={slug} data-reveal>
                <!-- Grille explicite : le repli en flex désalignait tout sur
                     mobile. Colonne 1 le numéro, colonne 2 le titre et les
                     tags calés dessous, l'étiquette toujours à droite. -->
                <summary class="grid grid-cols-[minmax(0,1fr)_auto] items-center gap-x-4 gap-y-[9px] py-[26px] hover:text-[var(--accent)] sm:grid-cols-[minmax(0,1fr)_minmax(0,1fr)_auto]">
                  <h3 class="swiss-row-title col-start-1 row-start-1">{project.data.title}</h3>

                  <span class="swiss-meta col-start-1 col-end-2 row-start-2 text-[var(--ink-soft)] sm:col-start-2 sm:col-end-3 sm:row-start-1">
                    {project.data.tags.join(', ')}
                  </span>

                  <!-- Un signe plutôt qu'un verbe : le pointeur dit déjà VIEW
                       et CLOSE au survol, mais au doigt il n'y a pas de
                       pointeur — le repère doit donc rester. -->
                  <span
                    class="col-start-2 row-start-1 row-span-2 flex h-[16px] w-[16px] items-center justify-center justify-self-end self-center text-[var(--ink-soft)] group-open:text-[var(--accent)] sm:col-start-3 sm:row-span-1"
                    aria-hidden="true"
                  >
                    <svg width="14" height="14" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="1.4">
                      <path d="M0 7h14" />
                      <path d="M7 0v14" class="origin-center transition-transform duration-300 ease-out group-open:rotate-90 group-open:opacity-0" />
                    </svg>
                  </span>
                </summary>

                <!-- Quatre points de marge en haut : le contenu de la ligne
                     est rogné à ras bord le temps de l'ouverture, et le
                     contour du bouton y laissait son filet supérieur. -->
                <div class="pt-[4px] pb-[22px]">
                  <!-- L'adresse suit le texte dans sa colonne. Sous les
                       visuels, elle n'était trouvée que par ceux qui poussaient
                       la planche jusqu'au bout ; rangée dans la colonne de
                       droite, elle flottait seule dans un pan vide. Ici elle
                       tombe là où l'œil arrive en finissant de lire, et
                       téléphone comme grand écran la placent au même endroit.
                       Les visuels restent en dessous, donc vus avant qu'on
                       parte. -->
                  <div class="swiss-grid mb-[22px] gap-y-[20px]">
                    {Body && (
                      <div class="project-body col-span-6 text-[16px] leading-[1.55] text-[var(--ink-soft)] md:col-span-7 md:text-[17px]">
                        <Body />
                      </div>
                    )}

                    {project.data.link && (
                      <div class="col-span-6 md:col-span-7">
                        <a
                          href={project.data.link}
                          target="_blank"
                          rel="noopener noreferrer"
                          class="inline-flex items-center gap-[10px] rounded-full border border-[var(--accent)] px-[24px] py-[11px] text-[15px] font-medium tracking-[-0.01em] text-[var(--accent)] transition-colors duration-200 hover:bg-[var(--accent)] hover:text-[var(--paper)]"
                        >
                          {domainLabel(project.data.link)}
                          <SwissArrow size={16} />
                        </a>
                      </div>
                    )}
                  </div>

                  <SwissFilmstrip images={project.data.images} title={project.data.title} />
                </div>
              </details>
            ))
          }
        </div>
      </div>
    </section>

    <!-- And also : même grammaire tabulaire, en plus petit. -->
    <section class="swiss-shell">
      <div class="swiss-grid gap-y-4 border-t border-[var(--rule)]" data-reveal>
        <h2 class="section-label swiss-meta col-span-6 text-[var(--ink-soft)] md:col-span-2">And also
        </h2>

        <ul class="also-list col-span-6 md:col-span-10">
          {
            also.map((item) => (
              <li class="border-b border-[var(--rule)] last:border-b-0" data-reveal>
                <a
                  href={item.link}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="grid grid-cols-[minmax(0,1fr)_auto] items-center gap-x-4 gap-y-[9px] py-[22px] hover:text-[var(--accent)] sm:grid-cols-[minmax(0,1fr)_minmax(0,1fr)_auto]"
                >
                  <h3 class="also-title col-start-1 row-start-1 text-[clamp(1.125rem,1.8vw,1.5rem)] font-medium tracking-[-0.025em]">
                    {item.title}
                  </h3>

                  <span class="swiss-meta col-start-1 col-end-2 row-start-2 text-[var(--ink-soft)] sm:col-start-2 sm:col-end-3 sm:row-start-1">
                    {item.tags.join(', ')}
                  </span>

                  <span class="col-start-2 row-start-1 row-span-2 flex items-center justify-self-end self-center text-[var(--ink-soft)] sm:col-start-3 sm:row-span-1">
                    <SwissArrow size={17} />
                  </span>
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </section>
    <!-- Les deux terrains personnels, l'un sous l'autre. Côte à côte, l'un
         tenait sur une ligne et l'autre sur deux : la paire boitait. Chacun
         prend donc toute la largeur et suit le rythme des autres sections —
         aucune marge propre, sans quoi il respirerait plus large que le
         reste. À sa droite, un dessin au trait qui dit son sujet. -->
    <section class="swiss-shell">
      <div class="swiss-grid border-t border-[var(--rule)]" data-reveal>
        <a
          href="/lab"
          class="teaser group col-span-6 flex items-center justify-between gap-5 md:col-span-12"
        >
          <span class="block min-w-0">
            <h2 class="section-label swiss-meta text-[var(--ink-soft)]">Creative lab</h2>
            <p class="lab-teaser-title mt-[16px] text-[clamp(1.375rem,2.6vw,2rem)] font-medium leading-[1.1] tracking-[-0.035em] group-hover:text-[var(--accent)]">
              Experiments where AI, design and code collide <SwissArrow direction="right" size={24} />
            </p>
          </span>

          <!-- Trois figures qui se chevauchent : le cercle, le carré et le
               triangle, les trois premières formes qu'on apprend à tracer.
               Elles se percutent comme les trois matières de la phrase, et
               aucune ne cède le passage à l'autre. -->
          <svg
            class="teaser-mark h-[54px] w-auto shrink-0 text-[var(--accent)] sm:h-[76px]"
            viewBox="0 0 150 76"
            fill="none"
            stroke="currentColor"
            stroke-width="1"
            aria-hidden="true"
          >
            <circle class="mark-haut" cx="34" cy="38" r="26" />
            <rect class="mark-milieu" x="44" y="12" width="52" height="52" />
            <path class="mark-bas" d="M88 64h52L114 12Z" />
          </svg>
        </a>
      </div>
    </section>

    <section class="swiss-shell">
      <div class="swiss-grid border-t border-[var(--rule)]" data-reveal>
        <a
          href="/lepolographe"
          class="teaser group col-span-6 flex items-center justify-between gap-5 md:col-span-12"
        >
          <span class="block min-w-0">
            <h2 class="section-label swiss-meta text-[var(--ink-soft)]">Le Polographe</h2>
            <p class="lab-teaser-title mt-[16px] text-[clamp(1.375rem,2.6vw,2rem)] font-medium leading-[1.1] tracking-[-0.035em] group-hover:text-[var(--accent)]">
              A few shapes on a grid, piled up into chaos <SwissArrow direction="right" size={24} />
            </p>
          </span>

          <!-- Huit cases, huit formes : quarts de cercle, cercle, demi-cercle
               triangle et carré, tous tirés du même petit jeu, seule
               l'orientation change. C'est la règle des affiches. Les carrés sont posés au
               centre de leur case plutôt que sur ses bords, sans quoi ils se
               confondraient avec la grille. Même cadre que le dessin du Lab,
               au point près, pour que les deux renvois pèsent pareil. -->
          <svg
            class="teaser-mark h-[54px] w-auto shrink-0 text-[var(--accent)] sm:h-[76px]"
            viewBox="0 0 150 76"
            fill="none"
            stroke="currentColor"
            stroke-width="1"
            aria-hidden="true"
          >
            <path d="M1 1v74M38 1v74M75 1v74M112 1v74M149 1v74" />
            <path d="M1 1h148M1 38h148M1 75h148" />
            <g class="mark-formes">
              <path pathLength="100" d="M1 38A37 37 0 0 1 38 1" />
              <path pathLength="100" d="M38 19.5a18.5 18.5 0 1 0 37 0a18.5 18.5 0 1 0-37 0" />
              <path pathLength="100" d="M75 1A37 37 0 0 1 112 38" />
              <path pathLength="100" d="M121.25 10.25h18.5v18.5h-18.5Z" />
              <path pathLength="100" d="M1 75 19.5 38 38 75Z" />
              <path pathLength="100" d="M38 75A37 37 0 0 1 75 38" />
              <path pathLength="100" d="M75 75A18.5 18.5 0 0 1 112 75" />
              <path pathLength="100" d="M112 38A37 37 0 0 1 149 75" />
            </g>
          </svg>
        </a>
      </div>
    </section>

  </main>

  <SwissFooter />

  <script is:inline data-astro-rerun>
    // La bande des compétences ralentit au survol au lieu de s'arrêter : une
    // piste qui se fige se lit comme une panne, une piste qui traîne se lit
    // comme une invitation à lire. Le CSS ne sait faire que le tout ou rien,
    // on règle donc la vitesse de lecture de son animation — elle reste la
    // sienne, et tient sans JavaScript.
    (() => {
      const bande = document.querySelector('.marquee');
      const piste = bande?.querySelector('.marquee-track');
      if (!piste || matchMedia('(prefers-reduced-motion: reduce)').matches) return;

      const anim = piste.getAnimations?.()[0];
      if (!anim) return;

      // Le ralenti est réglé sur le temps et non sur les images : un simple
      // rattrapage par fraction s'effondre en deux images sur un écran rapide
      // — quatre-vingts millisecondes suffisaient à manger neuf dixièmes de la
      // vitesse, et cela se lisait encore comme un arrêt sec. Une demi-seconde
      // pleine, sur une courbe douce des deux bouts : le mot ralentit avant de
      // se poser, et repart de même.
      const DUREE = 520;
      const doux = (x) => (x < 0.5 ? 4 * x * x * x : 1 - Math.pow(-2 * x + 2, 3) / 2);

      let depart = 1;
      let cible = 1;
      let debut = 0;
      let tourne = false;

      const suivre = (maintenant) => {
        const avance = Math.min(1, (maintenant - debut) / DUREE);
        anim.playbackRate = depart + (cible - depart) * doux(avance);
        if (avance < 1) requestAnimationFrame(suivre);
        else tourne = false;
      };

      const viser = (v) => {
        if (cible === v) return;
        depart = anim.playbackRate;
        cible = v;
        debut = performance.now();
        if (!tourne) {
          tourne = true;
          requestAnimationFrame(suivre);
        }
      };

      // Un cinquième de l'allure : assez lent pour lire un intitulé au vol,
      // assez vivant pour qu'on voie que rien n'est cassé.
      bande.addEventListener('pointerenter', () => viser(0.2));
      bande.addEventListener('pointerleave', () => viser(1));
    })();
  </script>

  <script is:inline data-astro-rerun>
    // Le point qui ferme le titre est la seule couleur de la page : en
    // cliquant dessus, le visiteur la fait tourner sur une petite gamme
    // arrêtée, et le site garde son choix sur son appareil. Rien ne l'annonce
    // — le curseur le dit au survol, ce qui suffit à qui regarde.
    (() => {
      const point = document.querySelector('[data-accent-cycle]');
      if (!point) return;

      const gamme = ['', 'vermillon', 'outremer', 'veronese', 'safran'];

      point.addEventListener('click', () => {
        const root = document.documentElement;
        const suivante = gamme[(gamme.indexOf(root.dataset.swissAccent || '') + 1) % gamme.length];
        if (suivante) root.dataset.swissAccent = suivante;
        else delete root.dataset.swissAccent;
        try {
          if (suivante) localStorage.setItem('swiss-accent', suivante);
          else localStorage.removeItem('swiss-accent');
        } catch {}
      });
    })();
  </script>

  <script is:inline data-astro-rerun>
    // Un clic n'importe où dans une ligne dépliée la referme et la ramène au
    // centre. Les liens gardent la main.
    (() => {
      // La molette verticale fait avancer la planche : sur trackpad comme à la
      // souris, on ne devrait pas avoir à chercher le geste latéral.
      for (const wrap of document.querySelectorAll('.filmstrip-wrap')) {
        const strip = wrap.querySelector('.filmstrip');
        const prev = wrap.querySelector('[data-strip-prev]');
        const next = wrap.querySelector('[data-strip-next]');
        if (!strip || !prev || !next) continue;

        // Un pas = la largeur d'un visuel plus la gouttière.
        const step = () => {
          const figure = strip.querySelector('figure');
          return figure ? figure.getBoundingClientRect().width + 10 : strip.clientWidth;
        };

        const sync = () => {
          // La bande déborde des gouttières : son origine n'est pas zéro mais
          // la valeur de son propre retrait.
          const origin = parseFloat(getComputedStyle(strip).paddingLeft) || 0;
          const max = strip.scrollWidth - strip.clientWidth;
          prev.disabled = strip.scrollLeft <= origin + 1;
          next.disabled = strip.scrollLeft >= max - 1;
        };

        prev.addEventListener('click', () => strip.scrollBy({ left: -step() }));
        next.addEventListener('click', () => strip.scrollBy({ left: step() }));
        strip.addEventListener('scroll', sync, { passive: true });
        sync();
      }

      for (const strip of document.querySelectorAll('.filmstrip')) {
        strip.addEventListener(
          'wheel',
          (event) => {
            if (Math.abs(event.deltaY) <= Math.abs(event.deltaX)) return;
            const max = strip.scrollWidth - strip.clientWidth;
            const next = strip.scrollLeft + event.deltaY;
            if (next <= 0 || next >= max) return; // on rend la main à la page
            event.preventDefault();
            strip.scrollLeft = next;
          },
          { passive: false }
        );
      }

      // Clavier : la page s'appelle Index, elle se parcourt donc au clavier.
      // ↑ ↓ d'un projet à l'autre, Entrée ouvre, Échap ferme, ← → dans la
      // planche du projet ouvert.
      const rows = [...document.querySelectorAll('#work details')];
      const summaries = rows.map((row) => row.querySelector('summary'));

      document.addEventListener('keydown', (event) => {
        if (event.metaKey || event.ctrlKey || event.altKey) return;
        const tag = event.target?.tagName;
        if (tag === 'INPUT' || tag === 'TEXTAREA' || event.target?.isContentEditable) return;

        const openRow = rows.find((row) => row.open);

        if (event.key === 'Escape' && openRow) {
          event.preventDefault();
          openRow.open = false;
          openRow.querySelector('summary')?.focus();
          return;
        }

        if (event.key === 'ArrowLeft' || event.key === 'ArrowRight') {
          if (!openRow) return;
          const strip = openRow.querySelector('.filmstrip');
          const figure = strip?.querySelector('figure');
          if (!strip || !figure) return;
          event.preventDefault();
          const step = figure.getBoundingClientRect().width + 10;
          strip.scrollBy({ left: event.key === 'ArrowRight' ? step : -step });
          return;
        }

        if (event.key !== 'ArrowDown' && event.key !== 'ArrowUp') return;

        const current = summaries.indexOf(document.activeElement?.closest('summary'));
        const next = current === -1
          ? 0
          : Math.min(summaries.length - 1, Math.max(0, current + (event.key === 'ArrowDown' ? 1 : -1)));

        event.preventDefault();
        summaries[next]?.focus();
        summaries[next]?.scrollIntoView({ block: 'center', behavior: 'smooth' });
      });

      // Une ligne qui s'ouvre ou se ferme ne doit pas emporter la page. Son
      // titre est collant tant qu'elle est ouverte : en se refermant il
      // retrouve sa place naturelle, très au-dessus, et la vue sautait avec
      // lui. On note où il est avant, et on rattrape l'écart au pixel après.
      // Le défilement doit être sec : `scroll-behavior: smooth` s'applique
      // aussi aux défilements programmés, et filerait sur toute la distance.
      const pin = (row) => {
        const summary = row.querySelector(':scope > summary');
        if (!summary) return;
        const before = summary.getBoundingClientRect().top;
        requestAnimationFrame(() => {
          const delta = summary.getBoundingClientRect().top - before;
          if (Math.abs(delta) > 1) scrollBy({ top: delta, behavior: 'instant' });
        });
      };

      for (const row of document.querySelectorAll('#work details')) {
        const summary = row.querySelector(':scope > summary');
        // Le clic précède la bascule : c'est le moment de relever la position.
        summary?.addEventListener('click', () => pin(row));

        const panel = row.querySelector(':scope > div');
        if (!panel) continue;

        // Cliquer dans la planche referme la ligne, sans bouger la page.
        panel.addEventListener('click', (event) => {
          if (event.target.closest('a, button')) return;
          pin(row);
          row.open = false;
        });
      }
    })();
  </script>
</SwissLayout>
