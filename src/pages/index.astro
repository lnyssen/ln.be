    // la fait glisser au doigt ou à la souris, on la pousse au pavé tactile.
    // Relâchée, elle garde un peu d'élan puis reprend son allure. Un
    // glissement n'ouvre pas le projet sous le doigt ; un toucher, si.
    (() => {
      const bande = document.querySelector('.marquee-images');
      const piste = bande?.querySelector('.marquee-track');
      if (!piste) return;
