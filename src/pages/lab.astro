---
import { getCollection } from 'astro:content';
import SwissLayout from '../layouts/SwissLayout.astro';
import SwissHeader from '../components/SwissHeader.astro';
import SwissFooter from '../components/SwissFooter.astro';
import SwissArrow from '../components/SwissArrow.astro';
import { Image } from 'astro:assets';
import { resolveImage } from '../lib/images';

const entries = (await getCollection('lab')).sort(
  (a, b) => a.data.order - b.data.order
);

---

<SwissLayout
  title="Laurent Nyssen — Creative Lab"
  description="Creative experiments where AI, design, and code collide."
>
  <SwissHeader current="lab" />

  <main>
    <section class="swiss-shell pb-[32px] pt-[40px] md:pt-[72px]">
      <h1 class="swiss-display" data-reveal data-reveal-slow>
        Creative<br />lab<span class="text-[var(--accent)]">.</span>
      </h1>

      <div class="swiss-grid mt-[40px] gap-y-6 border-t border-[var(--rule)] pt-[16px]" data-reveal data-reveal-slow data-reveal-delay="140">
        <h2 class="section-label swiss-meta col-span-6 text-[var(--ink-soft)] md:col-span-2">
          Statement
        </h2>

        <p class="swiss-lede col-span-6 md:col-span-8">
          Creative experiments where AI, design, and code collide. Light, sound,
          motion — generative visuals, playable instruments, interfaces that
          answer back. Each piece is a small machine for making something, built
          to be touched, not just looked at.
        </p>

        <p class="swiss-meta col-span-6 text-[var(--ink-soft)] md:col-span-2 md:justify-self-end">
          {entries.length} pieces
        </p>
      </div>
    </section>

    <!-- Une entrée par bande pleine largeur : le visuel occupe la moitié. -->
    <section class="swiss-shell pb-[64px]">
      {
        entries.map((entry, i) => (
          <article class="swiss-grid gap-y-5 border-t border-[var(--rule)] py-[28px]" data-reveal>
            <div class="col-span-6 md:col-start-3 md:col-span-3">
              {resolveImage(entry.data.image) && (
                <Image
                  src={resolveImage(entry.data.image)!}
                  alt=""
                  widths={[400, 560, 800]}
                  sizes="(min-width: 768px) 560px, 90vw"
                  format="webp"
                  quality={72}
                  loading="lazy"
                  class="aspect-square w-full object-cover"
                />
              )}
            </div>

            <div class="col-span-6 flex flex-col md:col-span-6">
              <h2 class="text-[clamp(1.75rem,3.6vw,3rem)] font-medium leading-[1.02] tracking-[-0.04em]">
                {entry.data.title}
              </h2>

              <p class="mt-[14px] flex-1 text-[15px] leading-[1.5] text-[var(--ink-soft)] md:text-[16px]">
                {entry.data.summary}
              </p>

              <div class="swiss-meta mt-[20px] flex flex-wrap gap-[18px]">
                {entry.data.demo && (
                  <a
                    href={entry.data.demo}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="rounded-full border border-[var(--accent)] bg-[var(--accent)] px-[20px] py-[9px] text-[var(--paper)]"
                  >
                    Try it <SwissArrow size={15} />
                  </a>
                )}
                {entry.data.doc && (
                  <a
                    href={entry.data.doc}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="rounded-full border border-[var(--rule)] px-[20px] py-[9px] hover:border-[var(--accent)] hover:text-[var(--accent)]"
                  >
                    Instructions <SwissArrow direction="down" size={15} />
                  </a>
                )}
              </div>
            </div>
          </article>
        ))
      }
    </section>
  </main>

  <SwissFooter />
</SwissLayout>
