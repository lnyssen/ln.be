---
import { getCollection } from 'astro:content';
import SwissLayout from '../layouts/SwissLayout.astro';
import SwissHeader from '../components/SwissHeader.astro';
import SwissFooter from '../components/SwissFooter.astro';
import SwissArrow from '../components/SwissArrow.astro';
import { Image } from 'astro:assets';
import { resolveImage } from '../lib/images';

const entries = (await getCollection('lab')).sort(
  (a, b) => a.data.order - b.data.order
);

---

<SwissLayout
  title="Laurent Nyssen — Lab"
  description="Creative experiments where AI, design, and code collide."
>
  <SwissHeader current="lab" />

  <main id="contenu" tabindex="-1">
    <section class="swiss-shell pb-[32px] pt-[var(--section-space)]">
      <h1 class="swiss-display" data-reveal data-reveal-slow>
        Lab<span class="text-[var(--accent-texte)]">.</span>
      </h1>

      <div class="swiss-grid mt-[40px] gap-y-6 border-t border-[var(--rule)] pt-[16px]" data-reveal data-reveal-slow data-reveal-delay="140">
        <h2 class="section-label swiss-meta col-span-6 text-[var(--ink-soft)] md:col-span-2">
          In short
        </h2>

        <p class="swiss-lede col-span-6 md:col-span-8">
          Creative experiments where AI, design, and code collide. Light, sound,
          motion — generative visuals, playable instruments, interfaces that
          answer back. Each piece is a small machine for making something, built
          to be touched, not just looked at.
        </p>

        <p class="swiss-meta col-span-6 text-[var(--ink-soft)] md:col-span-2 md:justify-self-end">
          {entries.length} experiments
        </p>
      </div>
    </section>

    <!-- Une entrée par bande pleine largeur : le visuel occupe la moitié. -->
    <section class="swiss-shell pb-[64px]">
      {
        entries.map((entry, i) => (
          <article class="swiss-grid gap-y-5 border-t border-[var(--rule)] pb-[var(--section-space)]" data-reveal>
            <div class="col-span-6 md:col-start-3 md:col-span-3">
              {resolveImage(entry.data.image) && (
                <Image
                  src={resolveImage(entry.data.image)!}
                  alt=""
                  widths={[400, 560, 800]}
                  sizes="(min-width: 768px) 560px, 90vw"
                  format="webp"
                  quality={72}
                  loading="lazy"
                  class="aspect-square w-full object-cover"
                />
              )}
            </div>

            <div class="col-span-6 flex flex-col md:col-span-6">
              <h2 class="text-[clamp(1.75rem,3.6vw,3rem)] font-medium leading-[1.02] tracking-[-0.04em]">
                {entry.data.title}
              </h2>

              <p class="mt-[14px] flex-1 text-[15px] leading-[1.5] text-[var(--ink-soft)] md:text-[16px]">
                {entry.data.summary}
              </p>

              <div class="swiss-meta mt-[20px] flex flex-wrap gap-[18px]">
                {entry.data.demo && (
                  <a
                    href={entry.data.demo}
                    target="_blank"
                    rel="noopener noreferrer"
                    data-cursor-mirror="Try it"
                    data-cursor-sign="VISIT"
                    data-cursor-ink="var(--accent-texte)"
                    class="bouton-lab rounded-full border border-[var(--accent)] bg-[var(--accent)] text-[var(--sur-accent)]"
                  >
                    <span class="bouton-lab-mot">Try it</span> <SwissArrow size={15} />
                  </a>
                )}
                {entry.data.doc && (
                  <a
                    href={entry.data.doc}
                    target="_blank"
                    rel="noopener noreferrer"
                    data-cursor-mirror="Instructions"
                    data-cursor-sign="DOWNLOAD"
                    data-cursor-ink="var(--ink)"
                    class="bouton-lab rounded-full border border-[var(--rule)] hover:border-[var(--accent-texte)] hover:text-[var(--accent-texte)]"
                  >
                    <span class="bouton-lab-mot">Instructions</span>
                    <!-- Le guide est un PDF : le signe dit qu'on le récupère,
                         pas qu'on change de page. Même trait que les flèches. -->
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="butt" aria-hidden="true" class="shrink-0">
                      <g class="telecharge-fleche">
                        <path d="M12 2.5v11" />
                        <path d="M6.5 8 12 13.5 17.5 8" />
                      </g>
                      <path d="M4 20.5h16" />
                    </svg>
                  </a>
                )}
              </div>
            </div>
          </article>
        ))
      }
    </section>
  </main>

  <SwissFooter />
</SwissLayout>
