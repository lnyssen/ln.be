---
import ProjectSlider from './ProjectSlider.jsx';
import GlobeIcon from './GlobeIcon.astro';

interface Props {
  title: string;
  tags: string[];
  images: string[];
  link?: string;
}

const { title, tags, images, link } = Astro.props;
---

<article>
  <ProjectSlider client:visible images={images} title={title} />

  <div class="mt-[15px] flex items-start justify-between gap-4">
    <div>
      <h3 class="display-sm font-display">{title}</h3>
      <p class="mt-[6px] text-base text-muted">{tags.join(' • ')}</p>
    </div>

    {
      link && (
        <a
          href={link}
          target="_blank"
          rel="noopener noreferrer"
          aria-label={`Visit ${title}`}
          class="mt-1 shrink-0 hover:opacity-85"
        >
          <GlobeIcon />
        </a>
      )
    }
  </div>
</article>
