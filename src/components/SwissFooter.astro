---
import SwissArrow from './SwissArrow.astro';

// Panneau violet fixé au fond : le contenu glisse par-dessus et le découvre en
// fin de course. `main` porte un fond opaque, le body réserve la hauteur.
//
// Sans intitulés, l'ours n'a plus qu'une règle : toutes les lignes ont le même
// corps, donc la ligne n de chaque colonne tombe à la même hauteur que la
// ligne n des autres. L'adresse, seule à changer de corps, prend une ligne à
// elle au-dessus plutôt que de décaler sa colonne d'un cran.
const elsewhere = [
  { label: 'LinkedIn', href: 'https://www.linkedin.com/in/laurentnyssen/' },
  { label: 'Spotify', href: 'https://open.spotify.com/user/laurentnyssen' },
  { label: 'Le Polographe', href: 'https://www.instagram.com/lepolographe/' },
];

const site = [
  { label: 'Colophon', href: '/colophon' },
  { label: 'Privacy', href: '/privacy' },
];
---

<footer
  class="swiss-footer fixed inset-x-0 bottom-0 z-0 flex h-[var(--footer-h)] flex-col justify-center pb-[env(safe-area-inset-bottom)]"
>
  <div class="swiss-shell swiss-grid footer-cols items-start gap-y-[26px]">
    <a
      href="mailto:hello@laurentnyssen.be"
      class="footer-mail col-span-6 text-[clamp(1.25rem,2.4vw,2rem)] font-medium tracking-[-0.03em] transition-colors duration-200 hover:text-[#141414] md:col-span-12"
    >
      hello@laurentnyssen.be
    </a>

    <div class="footer-col col-span-3 md:col-span-3">
      <a href="tel:+32497305080" class="swiss-meta w-fit opacity-70 hover:opacity-100">
        +32 (0)497 30 50 80
      </a>
      <p class="swiss-meta opacity-70">Brussels — BE</p>
      <p class="swiss-meta opacity-70">Available for commissions</p>
    </div>

    <div class="footer-col col-span-3 md:col-span-3">
      {
        elsewhere.map((item) => (
          <a
            href={item.href}
            target="_blank"
            rel="noopener noreferrer"
            class="swiss-meta block w-fit opacity-70 hover:opacity-100"
          >
            {item.label}<span class="footer-arrow"><SwissArrow size={12} /></span>
          </a>
        ))
      }
    </div>

    <div class="footer-col col-span-3 md:col-span-3">
      {
        site.map((item) => (
          <a
            href={item.href}
            class="swiss-meta w-fit underline decoration-1 underline-offset-[3px] opacity-70 hover:opacity-100"
          >
            {item.label}
          </a>
        ))
      }
      <p class="swiss-meta opacity-70">Set in Switzer</p>
    </div>

    <div class="footer-col col-span-3 md:col-span-2 md:items-end md:text-right">
      <p class="swiss-meta opacity-70">© {new Date().getFullYear()} LN</p>
    </div>
  </div>
</footer>
