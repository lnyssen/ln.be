---
import SwissArrow from './SwissArrow.astro';

// Panneau violet fixé au fond : le contenu glisse par-dessus et le découvre en
// fin de course. `main` porte un fond opaque, le body réserve la hauteur.
//
// La capsule d'outils flotte au bas de la fenêtre et reste là jusqu'au bout :
// c'est donc au panneau de lui laisser sa bande. Le contenu se centre dans ce
// qui reste au-dessus d'elle, et le panneau est assez haut pour que ce
// recentrage ne le colle pas à son bord supérieur.
//
// Trois étages, du plus grand au plus petit : l'accroche, les deux moyens de
// joindre, puis une seule ligne de mentions.
const elsewhere = [
  { label: 'LinkedIn', href: 'https://www.linkedin.com/in/laurentnyssen/' },
  { label: 'Spotify', href: 'https://open.spotify.com/user/laurentnyssen' },
];

const site = [
  { label: 'Colophon', href: '/colophon' },
  { label: 'Privacy', href: '/privacy' },
];
---

<footer
  class="swiss-footer fixed inset-x-0 bottom-0 z-0 flex h-[var(--footer-h)] flex-col justify-end pb-[calc(96px+env(safe-area-inset-bottom))]"
>
  <div class="swiss-shell">
    <!-- La fin de la page parle avec la voix de son titre : une accroche à
         l'échelle de l'ouverture, qui est tout entière le lien vers le mail.
         C'est la seule action du site, elle ne chuchote plus. -->
    <a href="mailto:hello@laurentnyssen.be" class="footer-appel group block w-fit" aria-label="Let's talk — hello@laurentnyssen.be">
      <span class="footer-accroche" aria-hidden="true">Let's talk<span class="footer-point">.</span></span>
      <span class="footer-fleche" aria-hidden="true">
        <SwissArrow size={44} direction="up-right" />
      </span>
    </a>

    <div class="footer-contacts">
      <a href="mailto:hello@laurentnyssen.be" class="footer-mail">hello@laurentnyssen.be</a>
      <a href="tel:+32497305080" class="footer-mail">+32 (0)497 30 50 80</a>
    </div>

    <div class="footer-ligne swiss-meta">
      <div class="footer-liens footer-liens-souple">
        <p>Brussels — BE</p>
        <p>Available for commissions</p>
      </div>
      <!-- Deux groupes qui ne se coupent jamais : ailleurs, puis le site. Au
           téléphone, chacun tient sa propre ligne. -->
      <nav aria-label="Elsewhere" class="footer-liens">
        {
          elsewhere.map((item) => (
            <a href={item.href} target="_blank" rel="noopener noreferrer">
              {item.label}
              <span class="footer-arrow">
                <SwissArrow size={11} direction="up-right" />
              </span>
            </a>
          ))
        }
      </nav>
      <nav aria-label="Site" class="footer-liens">
        {
          site.map((item) => (
            <a href={item.href}>
              {item.label}
              <span class="footer-arrow">
                <SwissArrow size={11} direction="right" />
              </span>
            </a>
          ))
        }
      </nav>
      <p class="footer-droits">© {new Date().getFullYear()} LN</p>
    </div>
  </div>
</footer>
