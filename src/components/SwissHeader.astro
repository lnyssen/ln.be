---
import LogoLockup from './LogoLockup.astro';

interface Props {
  current?: 'index' | 'lab' | 'polographe';
}

const { current = 'index' } = Astro.props;

// Sur la page où l'on se trouve déjà, le logo ne renvoie nulle part : deux
// liens voisins vers la même adresse — lui et le repère « Index » — n'aident
// personne, et un lecteur d'écran les annonce deux fois.
const accueil = Astro.url.pathname === '/';

// Une seule liste : la barre l'affiche en ligne sur grand écran, le panneau
// la reprend en pleine page sur téléphone. Deux rendus, une source.
const pages = [
  { href: '/', label: 'Index', key: 'index' },
  { href: '/lab', label: 'Lab', key: 'lab' },
  { href: '/lepolographe', label: 'Le Polographe', key: 'polographe' },
];
---

<header class="swiss-shell sticky top-0 z-50 pt-[calc(16px+env(safe-area-inset-top))]">
  <!-- La plaque de papier qui entoure la pilule. Elle reprend les mêmes
       gouttières et la même marge haute que la barre : son enfant a donc
       exactement la géométrie de la pilule, et l'ombre qu'il projette épouse
       sa courbe au pixel près. Elle est posée à part plutôt que portée par la
       pilule elle-même, car il faut la rogner, et rogner un ancêtre de la
       pilule la couperait de son arrière-plan : le flou disparaîtrait. -->
  <div
    class="header-plate swiss-shell pt-[calc(16px+env(safe-area-inset-top))]"
    aria-hidden="true"
  >
    <div class="plate-hole"></div>
  </div>

  <div class="header-pill flex items-center justify-between gap-4 rounded-full py-[15px] pl-[20px] pr-[12px] md:pl-[26px] md:pr-[14px]">
    {
      accueil ? (
        <span class="flex items-center">
          <LogoLockup class="h-[32px] w-auto shrink-0 text-[var(--ink)]" />
        </span>
      ) : (
        <!-- Le logo mène à l'accueil pour la main, comme partout. Au clavier
             et pour les lecteurs d'écran, il doublait le lien « Index »
             posé juste à côté — et le menu mobile porte le même : il se
             retire de leur parcours plutôt que de répéter. -->
        <a href="/" class="flex items-center" tabindex="-1" aria-hidden="true">
          <LogoLockup class="h-[32px] w-auto shrink-0 text-[var(--ink)]" />
        </a>
      )
    }

    <div class="flex items-center gap-[16px]">
      <!-- La page courante est marquée par une pastille qui glisse d'un
           repère à l'autre. Le nœud traverse les transitions de vue, sans
           quoi elle sauterait au lieu de glisser. -->
      <nav
        class="nav-track swiss-meta nav-link relative hidden items-center gap-[2px] min-[820px]:flex"
        aria-label="Main"
        data-nav
        transition:persist="nav"
      >
        <span class="nav-pill" aria-hidden="true"></span>
        {
          pages.map((page) => (
            <a
              href={page.href}
              data-nav-link
              data-key={page.key}
              class="relative z-10 flex h-[32px] items-center whitespace-nowrap rounded-full px-[13px] transition-colors duration-200"
              aria-current={current === page.key ? 'page' : undefined}
            >
              {page.label}
            </a>
          ))
        }
      </nav>

      <!-- La seule action de la barre : elle se distingue des repères de
           navigation par un cadre, à la hauteur des autres commandes. Elle
           reste hors de la teinte — l'encre du thème, ivoire sur le noir mat
           et noir mat sur l'ivoire : la couleur du nuancier change, le seul
           bouton de la barre ne bouge pas. -->
      <a
        href="mailto:hello@laurentnyssen.be"
        data-cursor-mirror="Get in touch"
        data-cursor-sign="MAIL"
        data-cursor-ink="var(--ink)"
        class="swiss-meta nav-link bouton-accent hidden h-[38px] shrink-0 items-center gap-[8px] rounded-full border border-[var(--ink)] px-[18px] text-[var(--ink)] hover:bg-[var(--ink)] hover:text-[var(--paper)] min-[820px]:inline-flex"
      >
        Get in touch
        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <path
            d="M3.5 6.5h17v11h-17z M3.5 7l8.5 6 8.5-6"
            stroke="currentColor"
            stroke-width="1.9"
            stroke-linecap="round"
            stroke-linejoin="round"
          />
        </svg>
      </a>

      <!-- Tant que la barre n'a pas la place des trois repères et du bouton,
           ils passent derrière un seul signe. Le seuil est mesuré, non
           supposé : il faut 685 points de contenu, soit 765 de fenêtre aux
           gouttières de 40, et l'on prend 820 pour laisser respirer. -->
      <button
        type="button"
        data-menu-toggle
        aria-expanded="false"
        aria-controls="swiss-menu"
        aria-label="Open menu"
        class="swiss-meta flex h-[38px] w-[38px] shrink-0 items-center justify-center rounded-full border border-[var(--rule)] transition-colors duration-200 min-[820px]:hidden"
      >
        <!-- Fermé, deux barres à l'encre de la barre. Ouvert, une croix. Deux
             signes superposés qui se relaient, chacun dessiné à sa place
             exacte. -->
        <svg width="16" height="16" viewBox="0 0 16 16" aria-hidden="true" class="menu-icon">
          <g stroke="currentColor" stroke-width="1.2" stroke-linecap="round" fill="none">
            <g class="icon-bars">
              <path d="M2 5h12" />
              <path d="M2 11h12" />
            </g>
            <g class="icon-cross">
              <path d="M4.6 4.6 11.4 11.4" />
              <path d="M11.4 4.6 4.6 11.4" />
            </g>
          </g>
        </svg>
      </button>
    </div>
  </div>
</header>

<!-- Le menu est une affiche : l'écran entier passe à la couleur, et les
     pages s'y écrivent en grand, à la voix du titre, l'une après l'autre.
     La page où l'on est prend le noir. -->
<div
  id="swiss-menu"
  data-menu-panel
  aria-hidden="true"
  inert
  class="swiss-menu fixed inset-0 z-40 min-[820px]:hidden"
>
  <div class="menu-affiche swiss-shell">
    <nav aria-label="Pages" class="menu-pages">
      {
        pages.map((page, i) => (
          <a
            href={page.href}
            class="menu-link"
            style={`--i: ${i}`}
            aria-current={current === page.key ? 'page' : undefined}
          >
            <span class="menu-mot">{page.label}</span>
          </a>
        ))
      }
    </nav>

    <div class="menu-pied" style={`--i: ${pages.length}`}>
      <a href="mailto:hello@laurentnyssen.be" class="menu-contact swiss-meta">
        Get in touch
        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <path
            d="M3.5 6.5h17v11h-17z M3.5 7l8.5 6 8.5-6"
            stroke="currentColor"
            stroke-width="1.9"
            stroke-linecap="round"
            stroke-linejoin="round"
          />
        </svg>
      </a>
    </div>
  </div>
</div>

<script is:inline data-astro-rerun>
  // Panneau de navigation : ouvert par le signe, fermé par la touche
  // d'échappement, par un second appui ou par le choix d'une page. Le corps
  // cesse de défiler derrière lui.
  (() => {
    const button = document.querySelector('[data-menu-toggle]');
    const panel = document.querySelector('[data-menu-panel]');
    if (!button || !panel) return;

    // La barre suit le rideau en deux temps. Son papier se retire avec lui,
    // rogné au même rythme (`menu-rideau`, posé dès le clic) : la couleur la
    // traverse sans à-coup. Son encre et son verre (`menu-open`), eux, ne
    // peuvent que basculer : ils le font à l'instant où le bord du rideau
    // passe le milieu de la pilule — ni avant, où le logo clair se serait
    // posé sur le papier, ni après, où l'encre sombre serait restée sur la
    // couleur. Cet instant dépend de la hauteur de l'écran : il est calculé,
    // pas deviné, à partir de la courbe et de la durée réelles du rideau.
    const pill = document.querySelector('.header-pill');
    const racine = document.documentElement;
    let bascule;

    // Fraction du temps écoulé quand une courbe de Bézier atteint `y`.
    const instant = (courbe, y) => {
      const [x1, y1, x2, y2] = courbe;
      const b = (a, c, s) => 3 * a * s * (1 - s) ** 2 + 3 * c * s * s * (1 - s) + s ** 3;
      let bas = 0;
      let haut = 1;
      for (let i = 0; i < 24; i++) {
        const s = (bas + haut) / 2;
        if (b(y1, y2, s) < y) bas = s;
        else haut = s;
      }
      return b(x1, x2, (bas + haut) / 2);
    };

    // Délai avant que le bord du rideau, qui descend (ou remonte), passe le
    // milieu de la pilule. Durée et courbe sont lues sur le panneau, qui
    // vient de recevoir sa transition : une seule source, la feuille de style.
    const delai = (open) => {
      const style = getComputedStyle(panel);
      const duree = parseFloat(style.transitionDuration) * 1000;
      const courbe = (style.transitionTimingFunction.match(/cubic-bezier\(([^)]+)\)/) || [])[1];
      if (!duree || !courbe || !pill) return 0;
      const r = pill.getBoundingClientRect();
      const part = (r.top + r.bottom) / 2 / panel.offsetHeight;
      const points = courbe.split(',').map(Number);
      return instant(points, open ? part : 1 - part) * duree;
    };

    const setState = (open) => {
      clearTimeout(bascule);
      // Le papier de la barre descend exactement jusqu'au bas de l'affiche.
      racine.style.setProperty('--rideau', `${panel.offsetHeight}px`);
      panel.classList.toggle('is-open', open);
      racine.classList.toggle('menu-rideau', open);
      panel.setAttribute('aria-hidden', String(!open));
      // Fermé, le panneau est inerte : ses liens ne se prennent ni au
      // clavier ni par les lecteurs d'écran.
      panel.inert = !open;
      button.setAttribute('aria-expanded', String(open));
      button.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
      if (open) requestAnimationFrame(() => document.addEventListener('click', dehors));
      else document.removeEventListener('click', dehors);
      // Sans mouvement, la durée lue vaut zéro : la bascule est immédiate.
      const attente = delai(open);
      const basculer = () => racine.classList.toggle('menu-open', open);
      if (attente > 0) bascule = setTimeout(basculer, attente);
      else basculer();
    };

    // Un clic hors de la carte la referme, comme on referme un tiroir.
    const dehors = (event) => {
      if (!panel.contains(event.target) && !button.contains(event.target)) setState(false);
    };

    button.addEventListener('click', () => setState(!panel.classList.contains('is-open')));

    panel.addEventListener('click', (event) => {
      if (event.target.closest('a')) setState(false);
    });

    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && panel.classList.contains('is-open')) {
        setState(false);
        button.focus();
      }
    });

    // Repasser en grand écran laisse le panneau ouvert derrière soi.
    matchMedia('(min-width: 820px)').addEventListener('change', (event) => {
      if (event.matches) setState(false);
    });
  })();
</script>

<script is:inline>
  // La pastille suit le repère survolé et revient sur la page courante. Elle
  // est mesurée plutôt que devinée : largeurs et positions varient avec la
  // longueur des mots et le format de l'écran.
  (() => {
    if (window.__swissNavPill) return;
    window.__swissNavPill = true;

    const cle = () => {
      const p = location.pathname;
      return p.startsWith('/lepolographe') ? 'polographe' : p.startsWith('/lab') ? 'lab' : 'index';
    };

    // La couleur suit la pastille, pas la page : le mot qu'elle recouvre
    // s'éclaire, celui qu'elle quitte reprend la sienne. Sans cela l'ancien
    // lien actif restait sombre sur fond sombre.
    const poser = (nav, lien, anime) => {
      const pastille = nav.querySelector('.nav-pill');
      if (!pastille || !lien) return;
      for (const a of nav.querySelectorAll('[data-nav-link]')) {
        a.classList.toggle('is-lit', a === lien);
      }
      pastille.style.transitionProperty = anime ? 'transform, width' : 'none';
      pastille.style.width = `${lien.offsetWidth}px`;
      pastille.style.transform = `translateX(${lien.offsetLeft}px)`;
      if (!anime) requestAnimationFrame(() => (pastille.style.transitionProperty = ''));
    };

    const courant = (nav) => nav.querySelector(`[data-key="${cle()}"]`);

    const caler = (anime) => {
      const nav = document.querySelector('[data-nav]');
      if (!nav) return;
      for (const a of nav.querySelectorAll('[data-nav-link]')) {
        const ici = a.dataset.key === cle();
        if (ici) a.setAttribute('aria-current', 'page');
        else a.removeAttribute('aria-current');
      }
      poser(nav, courant(nav), anime);
    };

    const brancher = () => {
      const nav = document.querySelector('[data-nav]');
      if (!nav || nav.dataset.bound) return;
      nav.dataset.bound = '1';
      for (const a of nav.querySelectorAll('[data-nav-link]')) {
        a.addEventListener('pointerenter', () => poser(nav, a, true));
      }
      nav.addEventListener('pointerleave', () => poser(nav, courant(nav), true));
    };

    const demarrer = () => {
      brancher();
      caler(false);
    };

    if (document.fonts?.ready) document.fonts.ready.then(demarrer);
    else demarrer();

    addEventListener('resize', () => caler(false));
    document.addEventListener('astro:after-swap', () => {
      brancher();
      caler(true);
    });
  })();
</script>
