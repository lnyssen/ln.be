---
import LogoLockup from './LogoLockup.astro';
import SwissThemeToggle from './SwissThemeToggle.jsx';

interface Props {
  current?: 'index' | 'lab';
}

const { current = 'index' } = Astro.props;

// Flèche en présentation texte : sans le sélecteur U+FE0E, iOS la rend en
// émoji bleu encadré.
const OUT = '↗︎';
---

<header class="swiss-shell sticky top-0 z-30 border-b border-[var(--rule)] pt-[env(safe-area-inset-top)]">
  <div class="flex items-center justify-between gap-4 py-[18px]">
    <a href="/" class="flex items-center">
      <LogoLockup class="h-[26px] w-auto shrink-0 text-[var(--ink)] md:h-[48px]" />
    </a>

    <div class="flex items-center gap-[16px]">
      <nav class="swiss-meta nav-link flex items-center gap-[16px]" aria-label="Main">
        <a
          href={current === 'index' ? '#work' : '/#work'}
          class:list={[
            'hidden sm:inline',
            current === 'index' ? 'text-[var(--accent)]' : 'hover:text-[var(--accent)]',
          ]}
          aria-current={current === 'index' ? 'page' : undefined}
        >
          Index
        </a>
        <a
          href="/lab"
          class={current === 'lab' ? 'text-[var(--accent)]' : 'hover:text-[var(--accent)]'}
          aria-current={current === 'lab' ? 'page' : undefined}
        >
          Lab
        </a>
      </nav>

      <!-- La seule action de la barre : elle se distingue des repères de
           navigation par un cadre, à la hauteur des deux autres commandes. -->
      <a
        href="mailto:hello@laurentnyssen.be"
        class="swiss-meta nav-link hidden h-[28px] shrink-0 items-center border border-[var(--rule)] px-[14px] transition-colors duration-200 hover:bg-[var(--ink)] hover:text-[var(--paper)] sm:inline-flex"
      >
        Get in touch
      </a>

      <button
        type="button"
        data-grid-toggle
        aria-pressed="false"
        aria-label="Afficher la grille"
        title="Grille (G)"
        class="swiss-meta flex h-[28px] w-[28px] shrink-0 items-center justify-center border border-[var(--rule)] transition-colors duration-200 hover:border-[var(--accent)] hover:text-[var(--accent)] aria-pressed:bg-[var(--ink)] aria-pressed:text-[var(--paper)]"
      >
        <svg width="14" height="14" viewBox="0 0 16 16" aria-hidden="true">
          <g stroke="currentColor" stroke-width="1">
            <path d="M2.5 1.5v13M6 1.5v13M9.5 1.5v13M13 1.5v13" />
          </g>
        </svg>
      </button>

      <SwissThemeToggle client:load />
    </div>
  </div>
</header>

<!-- Sur mobile, « Get in touch » quitte la barre, trop étroite, et devient une
     pilule à portée du pouce. Elle reste au-dessus de la zone sûre iOS. -->
<a
  href="mailto:hello@laurentnyssen.be"
  class="swiss-meta fixed bottom-[calc(20px+env(safe-area-inset-bottom))] right-[20px] z-40 flex items-center gap-[10px] rounded-full bg-[var(--ink)] px-[20px] py-[14px] font-semibold text-[var(--paper)] shadow-[0_4px_20px_rgba(0,0,0,0.3)] transition-opacity duration-200 hover:opacity-90 sm:hidden"
>
  Get in touch
  <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <path d="M3.5 6.5h17v11h-17z" />
    <path d="M3.5 7l8.5 6 8.5-6" />
  </svg>
</a>
