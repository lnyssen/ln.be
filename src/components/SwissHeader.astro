---
import LogoMark from './LogoMark.astro';
import SwissThemeToggle from './SwissThemeToggle.jsx';

interface Props {
  current?: 'index' | 'lab';
}

const { current = 'index' } = Astro.props;

// Flèche en présentation texte : sans le sélecteur U+FE0E, iOS la rend en
// émoji bleu encadré.
const OUT = '↗︎';
---

<header class="swiss-shell sticky top-0 z-30 border-b border-[var(--rule)] bg-[var(--paper)] pt-[env(safe-area-inset-top)]">
  <div class="flex items-center justify-between gap-4 py-[12px]">
    <a href="/" class="flex items-center gap-[12px]">
      <LogoMark class="h-[30px] w-[36px] shrink-0 text-[var(--ink)]" />

      <span class="inline-flex w-fit flex-col leading-tight">
        <span data-lockup-name class="block w-fit text-[16px] font-semibold tracking-[-0.03em]">
          Laurent Nyssen
        </span>
        <span
          data-lockup-sub
          class="block w-fit whitespace-nowrap uppercase leading-[1.2] text-[var(--ink-soft)]"
        >
          Multidisciplinary Designer
        </span>
      </span>
    </a>

    <div class="flex items-center gap-[14px]">
      <nav class="swiss-meta flex items-center gap-[14px]" aria-label="Main">
        <a
          href={current === 'index' ? '#work' : '/#work'}
          class={current === 'index' ? 'text-[var(--accent)]' : 'hover:text-[var(--accent)]'}
          aria-current={current === 'index' ? 'page' : undefined}
        >
          Index
        </a>
        <a
          href="/lab"
          class={current === 'lab' ? 'text-[var(--accent)]' : 'hover:text-[var(--accent)]'}
          aria-current={current === 'lab' ? 'page' : undefined}
        >
          Lab
        </a>
        <a
          href="mailto:hello@laurentnyssen.be"
          class="hidden hover:text-[var(--accent)] sm:inline"
        >
          Get in touch
        </a>
      </nav>

      <SwissThemeToggle client:load />
    </div>
  </div>
</header>

<script is:inline>
  // Le nom est la référence : le sous-titre est ramené à sa largeur exacte,
  // d'abord par le corps, puis affiné à l'interlettrage.
  (() => {
    const name = document.querySelector('[data-lockup-name]');
    const sub = document.querySelector('[data-lockup-sub]');
    if (!name || !sub) return;

    const fit = () => {
      sub.style.letterSpacing = '0px';
      sub.style.marginRight = '0px';
      sub.style.fontSize = '10px';

      const target = name.getBoundingClientRect().width;
      const at10 = sub.getBoundingClientRect().width;
      if (!target || !at10) return;

      // Corps proportionnel, borné pour rester lisible.
      const size = Math.min(11, Math.max(7, (10 * target) / at10));
      sub.style.fontSize = `${size.toFixed(2)}px`;

      // Le reliquat part dans l'interlettrage, compensé à droite pour que
      // l'espace ajoutée après le dernier signe ne décale pas le bloc.
      const natural = sub.getBoundingClientRect().width;
      const glyphs = sub.textContent.trim().length;
      const extra = (target - natural) / glyphs;
      sub.style.letterSpacing = `${extra.toFixed(3)}px`;
      sub.style.marginRight = `${(-extra).toFixed(3)}px`;
    };

    const run = () => requestAnimationFrame(fit);
    if (document.fonts?.ready) document.fonts.ready.then(run);
    else run();
    window.addEventListener('resize', run);
  })();
</script>
