---
import LogoLockup from './LogoLockup.astro';

interface Props {
  current?: 'index' | 'lab' | 'polographe';
}

const { current = 'index' } = Astro.props;

// La barre ne porte plus que le nom et l'action : la navigation a migré dans
// la pilule flottante, au bas de l'écran.
---

<header class="swiss-shell sticky top-0 z-50 border-b border-[var(--rule)] pt-[env(safe-area-inset-top)]">
  <div class="flex items-center justify-between gap-4 py-[18px]">
    <a href="/" class="flex items-center">
      <LogoLockup class="h-[32px] w-auto shrink-0 text-[var(--ink)] md:h-[40px]" />
    </a>

    <div class="flex items-center gap-[16px]">
      <!-- La seule action de la barre : elle se distingue des repères de
           navigation par un cadre, à la hauteur des autres commandes. -->
      <a
        href="mailto:hello@laurentnyssen.be"
        class="swiss-meta nav-link flex h-[38px] shrink-0 items-center rounded-full border border-[var(--rule)] px-[18px] transition-colors duration-200 hover:border-[var(--accent)] hover:bg-[var(--accent)] hover:text-[var(--paper)]"
      >
        Get in touch
      </a>

    </div>
  </div>
</header>
