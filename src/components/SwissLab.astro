---
// Trois outils cachés derrière une touche, dans la lignée de la grille.
// T : planche de spécimen — chaque texte dit son corps, sa graisse, son
//     interlettrage.
// W : réglette de graisse — Switzer est variable, autant le montrer.
// I : mode encre — le site simulé en risographie, deux encres et du grain.
---

<div data-specimen hidden class="specimen-layer" aria-hidden="true"></div>

<div data-weight-panel hidden class="weight-panel swiss-meta" aria-hidden="true">
  <span class="weight-label">Weight</span>
  <input
    type="range"
    min="-300"
    max="200"
    step="10"
    value="0"
    data-weight-range
    aria-label="Décalage de graisse"
  />
  <span data-weight-value class="weight-value tabular-nums">±0</span>
</div>

<script is:inline data-astro-rerun>
  (() => {
    if (window.__swissLab) return;
    window.__swissLab = true;

    const saisie = (event) =>
      event.metaKey ||
      event.ctrlKey ||
      event.altKey ||
      ['INPUT', 'TEXTAREA'].includes(event.target?.tagName) ||
      event.target?.isContentEditable;

    /* ---------- T : planche de spécimen -------------------------------- */

    // Un échantillon par famille de texte plutôt que tous les nœuds : la
    // planche doit se lire, pas se noyer.
    const CIBLES = [
      'h1',
      'h2',
      'h3',
      '.swiss-lede',
      '.lab-teaser-title',
      '.project-body p',
      '.privacy-body p',
      '.footer-mail',
      '.marquee-track span span',
      '[data-nav-link]',
    ].join(',');

    const couche = () => document.querySelector('[data-specimen]');

    const dessiner = () => {
      const calque = couche();
      if (!calque) return;
      calque.textContent = '';

      const vus = new Set();
      for (const el of document.querySelectorAll(CIBLES)) {
        const r = el.getBoundingClientRect();
        if (!r.width || !r.height) continue;

        const s = getComputedStyle(el);
        const corps = Math.round(parseFloat(s.fontSize));
        const graisse = s.fontWeight;
        const chasse = (parseFloat(s.letterSpacing) / corps || 0).toFixed(3);
        const signature = `${corps}/${graisse}/${chasse}`;

        // Deux fois la même volée n'apprend rien la seconde fois.
        if (vus.has(signature)) continue;
        vus.add(signature);

        const etiquette = document.createElement('span');
        etiquette.className = 'specimen-tag';
        etiquette.textContent = `${corps}px · ${graisse} · ${chasse}em`;
        etiquette.style.top = `${r.top + scrollY}px`;
        etiquette.style.left = `${r.left + scrollX}px`;
        calque.appendChild(etiquette);
      }
    };

    const basculerSpecimen = () => {
      const calque = couche();
      if (!calque) return;
      const ouvrir = calque.hidden;
      calque.hidden = !ouvrir;
      document.documentElement.classList.toggle('specimen-on', ouvrir);
      if (ouvrir) dessiner();
    };

    /* ---------- W : réglette de graisse --------------------------------- */

    // Le décalage est relatif : chaque texte garde son rang, toute la page
    // maigrit ou grossit ensemble. Les graisses de départ sont relevées une
    // fois pour toutes, sinon le décalage se cumulerait à chaque cran.
    const socle = new WeakMap();

    const peser = (decalage) => {
      for (const el of document.querySelectorAll('body *')) {
        if (!el.firstChild || el.closest('[data-specimen]')) continue;
        if (!socle.has(el)) {
          const w = parseFloat(getComputedStyle(el).fontWeight);
          if (!w) continue;
          socle.set(el, w);
        }
        const base = socle.get(el);
        if (!decalage) {
          el.style.fontVariationSettings = '';
          continue;
        }
        const cible = Math.min(900, Math.max(100, base + decalage));
        el.style.fontVariationSettings = `"wght" ${Math.round(cible)}`;
      }
    };

    const panneau = () => document.querySelector('[data-weight-panel]');

    const basculerGraisse = () => {
      const p = panneau();
      if (!p) return;
      const ouvrir = p.hidden;
      p.hidden = !ouvrir;
      if (!ouvrir) {
        p.querySelector('[data-weight-range]').value = '0';
        p.querySelector('[data-weight-value]').textContent = '±0';
        peser(0);
      }
    };

    document.addEventListener('input', (event) => {
      const curseur = event.target.closest?.('[data-weight-range]');
      if (!curseur) return;
      const v = Number(curseur.value);
      curseur
        .closest('[data-weight-panel]')
        .querySelector('[data-weight-value]').textContent =
        `${v > 0 ? '+' : v < 0 ? '−' : '±'}${Math.abs(v)}`;
      peser(v);
    });

    /* ---------- I : mode encre ----------------------------------------- */

    const basculerEncre = () => {
      document.documentElement.classList.toggle('ink-on');
    };

    /* ---------- Les trois touches --------------------------------------- */

    document.addEventListener('keydown', (event) => {
      if (saisie(event)) return;
      const k = event.key.toLowerCase();
      if (k === 't') basculerSpecimen();
      else if (k === 'w') basculerGraisse();
      else if (k === 'i') basculerEncre();
    });

    // La planche est posée en coordonnées de document : elle suit le
    // défilement, mais un changement de largeur la périme.
    addEventListener('resize', () => {
      if (!couche()?.hidden) dessiner();
    });
  })();
</script>
