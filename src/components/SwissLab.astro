---
// Un outil caché, dans la lignée de la grille.
// I : mode encre — le site simulé en risographie, deux encres et du grain.
---

<script is:inline data-astro-rerun>
  (() => {
    if (window.__swissLab) return;
    window.__swissLab = true;

    const saisie = (event) =>
      event.metaKey ||
      event.ctrlKey ||
      event.altKey ||
      ['INPUT', 'TEXTAREA'].includes(event.target?.tagName) ||
      event.target?.isContentEditable;

    document.addEventListener('keydown', (event) => {
      if (saisie(event)) return;
      if (event.key.toLowerCase() === 'i') document.documentElement.classList.toggle('ink-on');
    });
  })();
</script>
