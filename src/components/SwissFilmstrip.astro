---
import { Image } from 'astro:assets';
import { resolveImage } from '../lib/images';
import SwissArrow from './SwissArrow.astro';

interface Props {
  images: string[];
  title: string;
  // Les planches de projet sont des photographies, cadrées en 3:2. Une affiche
  // ne se recadre pas : la variante « poster » fixe la hauteur et laisse
  // chaque feuille prendre la largeur de son propre format.
  variant?: 'landscape' | 'poster';
  // Une planche posée dans une colonne ne déborde pas jusqu'aux marges, et
  // n'a pas besoin de flèches : elle se parcourt au doigt ou à la molette.
  bleed?: boolean;
  arrows?: boolean;
  // Ce que le disque du curseur annonce sur la planche. Sans valeur, il reste
  // nu : toutes les planches n'ont pas quelque chose à dire.
  cursor?: string;
}

const {
  images,
  title,
  variant = 'landscape',
  bleed = true,
  arrows = true,
  cursor,
} = Astro.props;
const poster = variant === 'poster';

const resolved = images
  .map((path) => ({ path, asset: resolveImage(path) }))
  .filter((entry) => entry.asset !== null);

const total = String(resolved.length).padStart(2, '0');
---

<!-- Planche contact : les visuels s'alignent en bande. Barre de défilement
     masquée, on avance aux flèches, au doigt, à la molette ou au clavier. -->
<div class="filmstrip-wrap relative" data-cursor={cursor}>
  <div
    class:list={[
      'filmstrip flex snap-x snap-mandatory gap-[10px] overflow-x-auto pb-[10px]',
      bleed && '-mx-[20px] px-[20px] md:-mx-[40px] md:px-[40px]',
    ]}
    role="group"
    aria-label={`${title} — ${total} visuels`}
    tabindex="0"
  >
    {
      resolved.map((entry, i) => (
        <figure
          class:list={[
            'm-0 shrink-0 snap-start',
            poster ? 'h-[64vw] max-h-[460px] md:h-[460px]' : 'w-[78vw] md:w-[440px]',
          ]}
        >
          <Image
            src={entry.asset!}
            alt={`${title} — visuel ${i + 1} sur ${resolved.length}`}
            widths={poster ? [340, 520, 700] : [440, 720, 880]}
            sizes={poster ? '(min-width: 768px) 330px, 46vw' : '(min-width: 768px) 440px, 78vw'}
            format="webp"
            quality={poster ? 82 : 72}
            loading="lazy"
            class:list={[poster ? 'h-full w-auto object-contain' : 'aspect-[3/2] w-full object-cover']}
          />
        </figure>
      ))
    }
  </div>

  {
    arrows && resolved.length > 1 && (
      <>
        <button
          type="button"
          data-strip-prev
          aria-label="Visuel précédent"
          class="strip-nav absolute left-[10px] top-[calc(50%-16px)] flex h-[44px] w-[44px] -translate-y-1/2 items-center justify-center rounded-full bg-[var(--ink)] text-[var(--paper)] transition-opacity duration-200 hover:opacity-85 disabled:pointer-events-none disabled:opacity-0"
        >
          <SwissArrow direction="left" size={17} />
        </button>

        <button
          type="button"
          data-strip-next
          aria-label="Visuel suivant"
          class="strip-nav absolute right-[10px] top-[calc(50%-16px)] flex h-[44px] w-[44px] -translate-y-1/2 items-center justify-center rounded-full bg-[var(--ink)] text-[var(--paper)] transition-opacity duration-200 hover:opacity-85 disabled:pointer-events-none disabled:opacity-0"
        >
          <SwissArrow direction="right" size={17} />
        </button>
      </>
    )
  }
</div>
