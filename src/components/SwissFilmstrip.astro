---
import { Image } from 'astro:assets';
import { resolveImage } from '../lib/images';
import SwissArrow from './SwissArrow.astro';

interface Props {
  images: string[];
  title: string;
}

const { images, title } = Astro.props;

const resolved = images
  .map((path) => ({ path, asset: resolveImage(path) }))
  .filter((entry) => entry.asset !== null);

const total = String(resolved.length).padStart(2, '0');
---

<!-- Planche contact : les visuels s'alignent en bande. Barre de défilement
     masquée, on avance aux flèches, au doigt, à la molette ou au clavier. -->
<div class="filmstrip-wrap relative">
  <div
    class="filmstrip -mx-[20px] flex snap-x snap-mandatory gap-[10px] overflow-x-auto px-[20px] pb-[10px] md:-mx-[40px] md:px-[40px]"
    role="group"
    aria-label={`${title} — ${total} visuels`}
    tabindex="0"
  >
    {
      resolved.map((entry, i) => (
        <figure class="m-0 w-[78vw] shrink-0 snap-start md:w-[440px]">
          <Image
            src={entry.asset!}
            alt={`${title} — visuel ${i + 1} sur ${resolved.length}`}
            widths={[440, 720, 880]}
            sizes="(min-width: 768px) 440px, 78vw"
            format="webp"
            quality={72}
            loading="lazy"
            class="aspect-[3/2] w-full object-cover"
          />
          <figcaption class="swiss-meta mt-[8px] text-[var(--ink-soft)]">
            {String(i + 1).padStart(2, '0')} / {total}
          </figcaption>
        </figure>
      ))
    }
  </div>

  {
    resolved.length > 1 && (
      <>
        <button
          type="button"
          data-strip-prev
          aria-label="Visuel précédent"
          class="strip-nav absolute left-[10px] top-[calc(50%-16px)] flex h-[44px] w-[44px] -translate-y-1/2 items-center justify-center bg-[var(--ink)] text-[var(--paper)] transition-opacity duration-200 hover:opacity-85 disabled:pointer-events-none disabled:opacity-0"
        >
          <SwissArrow direction="left" size={17} />
        </button>

        <button
          type="button"
          data-strip-next
          aria-label="Visuel suivant"
          class="strip-nav absolute right-[10px] top-[calc(50%-16px)] flex h-[44px] w-[44px] -translate-y-1/2 items-center justify-center bg-[var(--ink)] text-[var(--paper)] transition-opacity duration-200 hover:opacity-85 disabled:pointer-events-none disabled:opacity-0"
        >
          <SwissArrow direction="right" size={17} />
        </button>
      </>
    )
  }
</div>
