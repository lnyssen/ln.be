---
import { getCollection } from 'astro:content';
import ProjectCard from './ProjectCard.astro';
import AlsoSection from './AlsoSection.astro';
import MotionToggle from './MotionToggle.jsx';

const projects = (await getCollection('projects')).sort(
  (a, b) => a.data.order - b.data.order
);

// Le site empile deux colonnes indépendantes : impairs à gauche, pairs à
// droite, et le bloc « And also… » vient clore la colonne de droite.
const left = projects.filter((_, i) => i % 2 === 0);
const right = projects.filter((_, i) => i % 2 === 1);
---

<section id="work" class="shell pb-[40px] pt-[110px]">
  <div class="flex flex-wrap items-end justify-between gap-4">
    <h2 class="display-lg">Curated work</h2>
    <MotionToggle client:visible />
  </div>

  <div class="mt-[50px] grid grid-cols-1 gap-x-[50px] gap-y-[38px] md:grid-cols-2">
    <div class="flex flex-col gap-[38px]">
      {
        left.map((project) => (
          <ProjectCard
            title={project.data.title}
            tags={project.data.tags}
            images={project.data.images}
            link={project.data.link}
          />
        ))
      }
    </div>

    <div class="flex flex-col gap-[38px]">
      {
        right.map((project) => (
          <ProjectCard
            title={project.data.title}
            tags={project.data.tags}
            images={project.data.images}
            link={project.data.link}
          />
        ))
      }
      <AlsoSection />
    </div>
  </div>
</section>
