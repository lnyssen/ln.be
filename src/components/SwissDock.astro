---
import SwissThemeToggle from './SwissThemeToggle.jsx';

interface Props {
  current?: 'index' | 'lab' | 'polographe';
}

const { current = 'index' } = Astro.props;

// La navigation quitte la barre et flotte : une seule pilule au bas de
// l'écran, sous le pouce plutôt qu'en tête de page. Elle porte les trois
// pages puis, après un filet, les deux outils du visiteur. Un seul objet
// plutôt que deux, sinon ils se chevaucheraient sur un téléphone.
const pages = [
  { href: '/', label: 'Index', key: 'index' },
  { href: '/lab', label: 'Lab', key: 'lab' },
  { href: '/lepolographe', label: 'Le Polographe', key: 'polographe' },
];
---

<div
  class="swiss-dock fixed bottom-[calc(16px+env(safe-area-inset-bottom))] left-1/2 z-40 flex -translate-x-1/2 items-center"
>
  <div class="dock-capsule flex items-center gap-[2px] rounded-full p-[6px] sm:gap-[4px]">
    <nav class="flex items-center" aria-label="Main">
      {
        pages.map((page) => (
          <a
            href={page.href}
            class:list={[
              'dock-link swiss-meta flex h-[38px] items-center rounded-full px-[9px] transition-colors duration-200 sm:px-[17px]',
              current === page.key && 'is-current',
            ]}
            aria-current={current === page.key ? 'page' : undefined}
          >
            {page.key === 'polographe' ? (
              <>
                <span class="sm:hidden">Polographe</span>
                <span class="hidden sm:inline">Le Polographe</span>
              </>
            ) : (
              page.label
            )}
          </a>
        ))
      }
    </nav>

    <span class="dock-rule" aria-hidden="true"></span>

    <button
      type="button"
      data-grid-toggle
      aria-pressed="false"
      aria-label="Afficher la grille"
      title="Grille (G)"
      class="dock-link swiss-meta flex h-[38px] w-[38px] shrink-0 items-center justify-center rounded-full transition-colors duration-200"
    >
      <svg width="14" height="14" viewBox="0 0 16 16" aria-hidden="true">
        <g stroke="currentColor" stroke-width="1">
          <path d="M2.5 1.5v13M6 1.5v13M9.5 1.5v13M13 1.5v13" />
        </g>
      </svg>
    </button>

    <SwissThemeToggle client:load framed={false} />
  </div>
</div>
