---
import SwissThemeToggle from './SwissThemeToggle.jsx';

// Les outils du visiteur — la grille, la graisse et le thème — ne sont pas de
// la navigation : ils quittent la barre et se posent en capsule flottante,
// centrée au bas de l'écran et à portée du pouce. Le contact n'y figure pas :
// la barre le porte sur grand écran, la carte du menu sur téléphone.
---

<div
  class="swiss-dock fixed bottom-[calc(20px+env(safe-area-inset-bottom))] left-1/2 z-40 flex -translate-x-1/2 items-center gap-[12px]"
>
  <div
    class="dock-capsule flex items-center gap-[10px] rounded-full p-[7px] md:gap-[24px] md:p-[9px]"
  >
    <button
      type="button"
      data-grid-toggle
      aria-pressed="false"
      aria-label="Afficher la grille"
      title="Grille (G)"
      class="swiss-meta flex h-[38px] w-[38px] shrink-0 items-center justify-center rounded-full border border-[var(--rule)] transition-colors duration-200 hover:border-[var(--accent)] hover:bg-[var(--accent)] hover:text-[var(--paper)] aria-pressed:bg-[var(--ink)] aria-pressed:text-[var(--paper)]"
    >
      <svg width="14" height="14" viewBox="0 0 16 16" aria-hidden="true">
        <g stroke="currentColor" stroke-width="1">
          <path d="M2.5 1.5v13M6 1.5v13M9.5 1.5v13M13 1.5v13" />
        </g>
      </svg>
    </button>

    <button
      type="button"
      data-weight-toggle
      aria-pressed="false"
      aria-label="Régler la graisse"
      title="Graisse (W)"
      class="swiss-meta flex h-[38px] w-[38px] shrink-0 items-center justify-center rounded-full border border-[var(--rule)] transition-colors duration-200 hover:border-[var(--accent)] hover:bg-[var(--accent)] hover:text-[var(--paper)] aria-pressed:bg-[var(--ink)] aria-pressed:text-[var(--paper)]"
    >
      <svg width="15" height="15" viewBox="0 0 16 16" aria-hidden="true">
        <g stroke="currentColor" stroke-linecap="round">
          <path d="M3 4h10" stroke-width="0.9" />
          <path d="M3 8h10" stroke-width="1.8" />
          <path d="M3 12h10" stroke-width="3" />
        </g>
      </svg>
    </button>

    <SwissThemeToggle client:load />
  </div>
</div>
