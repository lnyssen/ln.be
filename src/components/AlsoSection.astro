---
import also from '../data/also.json';
import GlobeIcon from './GlobeIcon.astro';
---

<div class="pt-0">
  <h2 class="display-md font-display">And also…</h2>

  <ul class="mt-[30px] flex flex-col gap-[54px]">
    {
      also.map((item) => (
        <li class="flex items-start justify-between gap-4">
          <div>
            <p class="display-sm font-display">{item.title}</p>
            <p class="mt-[6px] text-base text-muted">{item.tags.join(' • ')}</p>
          </div>

          {item.link && (
            <a
              href={item.link}
              target="_blank"
              rel="noopener noreferrer"
              aria-label={`Visit ${item.title}`}
              class="mt-1 shrink-0 hover:opacity-85"
            >
              <GlobeIcon />
            </a>
          )}
        </li>
      ))
    }
  </ul>
</div>
