---
// Calque de grille : moins un outil qu'une épreuve d'imprimeur. Traits de
// coupe aux quatre angles, colonnes numérotées, et les mesures relevées en
// direct sur la page.
---

<div data-grid-overlay hidden class="grid-overlay pointer-events-none fixed inset-0 z-[45]">
  <!-- Colonnes, contournées plutôt que pleines : on lit la gouttière. -->
  <div class="swiss-shell swiss-grid h-full">
    {
      Array.from({ length: 12 }).map((_, i) => (
        <div
          class:list={[
            'grid-col relative h-full border-x border-[var(--grid-line)] bg-[var(--grid-fill)]',
            i >= 6 && 'hidden md:block',
          ]}
          style={`--col-delay:${i * 26}ms`}
        >
          <span class="absolute left-1/2 top-[calc(var(--header-h)+14px)] -translate-x-1/2 font-mono text-[9px] tabular-nums text-[var(--grid-ink)]">
            {String(i + 1).padStart(2, '0')}
          </span>
        </div>
      ))
    }
  </div>

  <!-- Traits de coupe : la page devient une feuille à massicoter. -->
  {
    [
      'left-0 top-0',
      'right-0 top-0 rotate-90',
      'right-0 bottom-0 rotate-180',
      'left-0 bottom-0 -rotate-90',
    ].map((corner) => (
      <svg
        class:list={['grid-mark absolute h-[30px] w-[30px] text-[var(--grid-ink)]', corner]}
        viewBox="0 0 34 34"
        fill="none"
        stroke="currentColor"
        stroke-width="1"
        aria-hidden="true"
      >
        <path d="M0 12h24M12 0v24" />
      </svg>
    ))
  }

  <!-- Relevé, comme une cartouche de plan. -->
  <div
    data-grid-readout
    class="grid-readout absolute bottom-[calc(16px+env(safe-area-inset-bottom))] left-[20px] flex gap-[12px] border border-[var(--grid-line)] bg-[var(--paper)] px-[10px] py-[6px] font-mono text-[9px] tabular-nums text-[var(--accent)] opacity-75 backdrop-blur-sm md:left-[40px]"
  >
    <span data-grid-vw>—</span>
    <span data-grid-bp>—</span>
    <span data-grid-cols>—</span>
    <span data-grid-colw>—</span>
  </div>
</div>
